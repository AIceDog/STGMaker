[gd_resource type="Resource" script_class="STGAttackProgramDefinition" load_steps=3 format=3]
[ext_resource type="Script" path="res://stg/definitions/attack_program_definition.gd" id="1"]
[ext_resource type="Script" path="res://stg/programs/fork_lightning.gd" id="2"]
[resource]
script = ExtResource("1")
kind = "attack"
id = "builtin.fork_lightning"
title = "分叉雷电"
capability = "Polyline2D"
implementation = ExtResource("2")
fields = Array[Dictionary]([{"name": "branches", "label": "分叉数量", "type": "int", "default": 3, "min": 1, "max": 6, "step": 1, "group": "运动", "help": ""}, {"name": "points", "label": "主干折线点数", "type": "int", "default": 9, "min": 3, "max": 24, "step": 1, "group": "运动", "help": ""}, {"name": "jitter", "label": "折线抖动", "type": "float", "default": 26.0, "min": 0, "max": 100, "step": 0.1, "group": "运动", "help": ""}, {"name": "width", "label": "主干宽度", "type": "float", "default": 10.0, "min": 4, "max": 32, "step": 0.1, "group": "运动", "help": ""}, {"name": "branch_angle", "label": "分叉角度 °", "type": "float", "default": 60.0, "min": 20, "max": 100, "step": 0.1, "group": "运动", "help": ""}, {"name": "branch_length", "label": "分叉长度比例", "type": "float", "default": 0.35, "min": 0.1, "max": 0.7, "step": 0.1, "group": "运动", "help": ""}, {"name": "warning", "label": "首次预警 s", "type": "float", "default": 0.4, "min": 0, "max": 2, "step": 0.1, "group": "运动", "help": ""}, {"name": "pulses", "label": "闪击次数", "type": "int", "default": 3, "min": 1, "max": 6, "step": 1, "group": "运动", "help": ""}, {"name": "active_time", "label": "每次生效 s", "type": "float", "default": 0.15, "min": 0.05, "max": 0.6, "step": 0.1, "group": "运动", "help": ""}, {"name": "gap", "label": "闪击间隔 s", "type": "float", "default": 0.18, "min": 0.05, "max": 0.8, "step": 0.1, "group": "运动", "help": ""}, {"name": "damage", "label": "伤害", "type": "float", "default": 1.0, "min": 0, "max": 10000, "group": "伤害"}, {"name": "damage_on_contact", "label": "接触时判伤", "type": "bool", "default": true, "group": "伤害"}, {"name": "hit_mode", "label": "命中方式", "type": "enum", "default": "persistent", "values": ["persistent", "activation", "repeat"], "labels": ["存在期间命中一次", "生效瞬间", "间隔重复"], "group": "伤害"}, {"name": "hit_interval", "label": "命中间隔 s", "type": "float", "default": 0.2, "min": 0.01, "max": 60, "group": "伤害"}, {"name": "tint", "label": "颜色倍率", "type": "color", "default": Color(1,1,1,1), "group": "表现"}, {"name": "texture_override", "label": "运行贴图", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "Texture2D", "group": "表现"}, {"name": "spawn_clip_override", "label": "出生动画", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "SpriteFrames", "group": "表现"}, {"name": "run_clip_override", "label": "运行动画", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "SpriteFrames", "group": "表现"}, {"name": "hit_clip_override", "label": "命中动画", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "SpriteFrames", "group": "收尾"}, {"name": "expire_clip_override", "label": "结束动画", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "SpriteFrames", "group": "收尾"}, {"name": "spawn_sound", "label": "出生音效", "type": "resource", "default": null, "resource_class": "AudioStream", "nullable": true, "group": "表现"}, {"name": "run_sound", "label": "持续音效", "type": "resource", "default": null, "resource_class": "AudioStream", "nullable": true, "group": "表现"}, {"name": "hit_sound", "label": "命中音效", "type": "resource", "default": null, "resource_class": "AudioStream", "nullable": true, "group": "收尾"}, {"name": "end_sound", "label": "结束音效", "type": "resource", "default": null, "resource_class": "AudioStream", "nullable": true, "group": "收尾"}, {"name": "spawn_effect", "label": "出生特效", "type": "resource", "default": null, "resource_class": "PackedScene", "nullable": true, "group": "表现"}, {"name": "hit_effect", "label": "命中特效", "type": "resource", "default": null, "resource_class": "PackedScene", "nullable": true, "group": "收尾"}, {"name": "end_effect", "label": "结束特效", "type": "resource", "default": null, "resource_class": "PackedScene", "nullable": true, "group": "收尾"}, {"name": "effect_duration", "label": "附加特效最长播放 s", "type": "float", "default": 2.0, "min": 0.01, "max": 60, "group": "收尾"}])
