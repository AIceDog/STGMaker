[gd_resource type="Resource" script_class="STGAttackProgramDefinition" load_steps=3 format=3]
[ext_resource type="Script" path="res://stg/definitions/attack_program_definition.gd" id="1"]
[ext_resource type="Script" path="res://stg/programs/summon.gd" id="2"]
[resource]
script = ExtResource("1")
kind = "attack"
id = "builtin.summon"
title = "召唤敌人"
capability = "SummonEnemy"
implementation = ExtResource("2")
fields = Array[Dictionary]([{"name": "count", "label": "召唤数量", "type": "int", "default": 1, "min": 1, "max": 64, "step": 1, "group": "运动 / 发射"}, {"name": "interval", "label": "召唤间隔 s", "type": "float", "default": 0.25, "min": 0, "max": 30, "step": 0.1, "group": "运动 / 发射"}, {"name": "duration", "label": "最多存活 s", "type": "float", "default": 12, "min": 0.05, "max": 60, "step": 0.1, "group": "运动 / 发射"}, {"name": "offset", "label": "出生偏移", "type": "vector2", "default": Vector2(0,0)}, {"name": "entry_velocity", "label": "入场速度 XY", "type": "vector2", "default": Vector2(200,0)}, {"name": "entry_duration", "label": "入场时间 s（0 原地）", "type": "float", "default": 0, "min": 0, "max": 10, "step": 0.1, "group": "运动 / 发射"}])
