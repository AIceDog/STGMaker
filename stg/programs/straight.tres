[gd_resource type="Resource" script_class="STGAttackProgramDefinition" load_steps=3 format=3]
[ext_resource type="Script" path="res://stg/definitions/attack_program_definition.gd" id="1"]
[ext_resource type="Script" path="res://stg/programs/straight.gd" id="2"]
[resource]
script = ExtResource("1")
kind = "attack"
id = "builtin.straight"
title = "直线弹"
capability = "Body2D"
implementation = ExtResource("2")
fields = Array[Dictionary]([{"name": "speed", "label": "飞行速度 px/s", "type": "float", "default": 220, "min": 0, "max": 2000, "step": 0.1, "group": "运动 / 发射"}, {"name": "duration", "label": "弹体寿命 s", "type": "float", "default": 4, "min": 0.05, "max": 60, "step": 0.1, "group": "运动 / 发射"}, {"name": "angle", "label": "初始方向 °", "type": "float", "default": 180, "min": -360, "max": 360, "step": 0.1, "group": "运动 / 发射"}, {"name": "count", "label": "每轮数量", "type": "int", "default": 1, "min": 1, "max": 128, "step": 1, "group": "运动 / 发射"}, {"name": "rounds", "label": "轮数", "type": "int", "default": 1, "min": 1, "max": 16, "step": 1, "group": "运动 / 发射"}, {"name": "interval", "label": "轮间隔 s", "type": "float", "default": 0.25, "min": 0, "max": 30, "step": 0.1, "group": "运动 / 发射"}, {"name": "group_size", "label": "每组数量（0 齐射）", "type": "int", "default": 0, "min": 0, "max": 128, "step": 1, "group": "运动 / 发射"}, {"name": "group_interval", "label": "组间隔 s", "type": "float", "default": 0.1, "min": 0, "max": 30, "step": 0.1, "group": "运动 / 发射"}, {"name": "damage", "label": "伤害", "type": "float", "default": 1.0, "min": 0, "max": 10000, "group": "伤害"}, {"name": "damage_on_contact", "label": "接触时判伤", "type": "bool", "default": true, "group": "伤害"}, {"name": "hit_mode", "label": "命中方式", "type": "enum", "default": "persistent", "values": ["persistent", "activation", "repeat"], "labels": ["存在期间命中一次", "生效瞬间", "间隔重复"], "group": "伤害"}, {"name": "hit_interval", "label": "命中间隔 s", "type": "float", "default": 0.2, "min": 0.01, "max": 60, "group": "伤害"}, {"name": "tint", "label": "颜色倍率", "type": "color", "default": Color(1,1,1,1), "group": "表现"}, {"name": "texture_override", "label": "运行贴图", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "Texture2D", "group": "表现"}, {"name": "spawn_clip_override", "label": "出生动画", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "SpriteFrames", "group": "表现"}, {"name": "run_clip_override", "label": "运行动画", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "SpriteFrames", "group": "表现"}, {"name": "hit_clip_override", "label": "命中动画", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "SpriteFrames", "group": "收尾"}, {"name": "expire_clip_override", "label": "结束动画", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "SpriteFrames", "group": "收尾"}, {"name": "spawn_particles_override", "label": "出生粒子", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "PackedScene", "group": "表现"}, {"name": "run_particles_override", "label": "运行粒子", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "PackedScene", "group": "表现"}, {"name": "hit_particles_override", "label": "命中粒子", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "PackedScene", "group": "收尾"}, {"name": "spawn_sound", "label": "出生音效", "type": "resource", "default": null, "resource_class": "AudioStream", "nullable": true, "group": "表现"}, {"name": "run_sound", "label": "持续音效", "type": "resource", "default": null, "resource_class": "AudioStream", "nullable": true, "group": "表现"}, {"name": "hit_sound", "label": "命中音效", "type": "resource", "default": null, "resource_class": "AudioStream", "nullable": true, "group": "收尾"}, {"name": "end_sound", "label": "结束音效", "type": "resource", "default": null, "resource_class": "AudioStream", "nullable": true, "group": "收尾"}, {"name": "spawn_effect", "label": "出生特效", "type": "resource", "default": null, "resource_class": "PackedScene", "nullable": true, "group": "表现"}, {"name": "hit_effect", "label": "命中特效", "type": "resource", "default": null, "resource_class": "PackedScene", "nullable": true, "group": "收尾"}, {"name": "end_effect", "label": "结束特效", "type": "resource", "default": null, "resource_class": "PackedScene", "nullable": true, "group": "收尾"}, {"name": "effect_duration", "label": "附加特效最长播放 s", "type": "float", "default": 2.0, "min": 0.01, "max": 60, "group": "收尾"}])
