[gd_resource type="Resource" script_class="STGAttackProgramDefinition" load_steps=3 format=3]
[ext_resource type="Script" path="res://stg/definitions/attack_program_definition.gd" id="1"]
[ext_resource type="Script" path="res://stg/programs/seeking_trail.gd" id="2"]
[resource]
script = ExtResource("1")
kind = "attack"
id = "builtin.seeking_trail"
title = "追踪尾迹"
capability = "Trail2D"
implementation = ExtResource("2")
fields = Array[Dictionary]([{"name": "width", "label": "尾迹宽度", "type": "float", "default": 20.0, "min": 6, "max": 64, "step": 0.1, "group": "运动", "help": ""}, {"name": "speed", "label": "追踪速度", "type": "float", "default": 170.0, "min": 20, "max": 400, "step": 0.1, "group": "运动", "help": ""}, {"name": "turn_rate", "label": "转向速度 °/s", "type": "float", "default": 95.0, "min": 0, "max": 240, "step": 0.1, "group": "运动", "help": ""}, {"name": "duration", "label": "生成时间 s", "type": "float", "default": 3.2, "min": 0.5, "max": 5, "step": 0.1, "group": "运动", "help": ""}, {"name": "segment_life", "label": "分段保留 s", "type": "float", "default": 0.9, "min": 0.2, "max": 2, "step": 0.1, "group": "运动", "help": ""}, {"name": "damage", "label": "伤害", "type": "float", "default": 1.0, "min": 0, "max": 10000, "group": "伤害"}, {"name": "damage_on_contact", "label": "接触时判伤", "type": "bool", "default": true, "group": "伤害"}, {"name": "hit_mode", "label": "命中方式", "type": "enum", "default": "persistent", "values": ["persistent", "repeat"], "labels": ["整条尾迹命中一次", "间隔重复"], "group": "伤害"}, {"name": "hit_interval", "label": "命中间隔 s", "type": "float", "default": 0.2, "min": 0.01, "max": 60, "group": "伤害"}, {"name": "tint", "label": "颜色倍率", "type": "color", "default": Color(1,1,1,1), "group": "表现"}, {"name": "texture_override", "label": "运行贴图", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "Texture2D", "group": "表现"}, {"name": "spawn_clip_override", "label": "出生动画", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "SpriteFrames", "group": "表现"}, {"name": "run_clip_override", "label": "运行动画", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "SpriteFrames", "group": "表现"}, {"name": "hit_clip_override", "label": "命中动画", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "SpriteFrames", "group": "收尾"}, {"name": "expire_clip_override", "label": "结束动画", "type": "resource_override", "default": {"mode": "inherit", "value": null}, "resource_class": "SpriteFrames", "group": "收尾"}, {"name": "spawn_sound", "label": "出生音效", "type": "resource", "default": null, "resource_class": "AudioStream", "nullable": true, "group": "表现"}, {"name": "run_sound", "label": "持续音效", "type": "resource", "default": null, "resource_class": "AudioStream", "nullable": true, "group": "表现"}, {"name": "hit_sound", "label": "命中音效", "type": "resource", "default": null, "resource_class": "AudioStream", "nullable": true, "group": "收尾"}, {"name": "end_sound", "label": "结束音效", "type": "resource", "default": null, "resource_class": "AudioStream", "nullable": true, "group": "收尾"}, {"name": "spawn_effect", "label": "出生特效", "type": "resource", "default": null, "resource_class": "PackedScene", "nullable": true, "group": "表现"}, {"name": "hit_effect", "label": "命中特效", "type": "resource", "default": null, "resource_class": "PackedScene", "nullable": true, "group": "收尾"}, {"name": "end_effect", "label": "结束特效", "type": "resource", "default": null, "resource_class": "PackedScene", "nullable": true, "group": "收尾"}, {"name": "effect_duration", "label": "附加特效最长播放 s", "type": "float", "default": 2.0, "min": 0.01, "max": 60, "group": "收尾"}])
