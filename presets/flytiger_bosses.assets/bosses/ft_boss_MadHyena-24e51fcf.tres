[resource]
script = ExtResource("ext_9")
id = "ft_boss_MadHyena"
title = "癫狂鬣狗"
description = "来源：Boss总览 / 阶段与转换，源码类 MadHyena。
出现条件：飞喵草原（grassland）限定；大海/群山除外；本局首次90%首秀掷骰，见过后普通池
阶段结构：单血；70/40/10%触发钻地
招式组合：咆哮双圈、连续冲撞、潜地追踪后出土
移动：地面咆哮与4–6次冲刺交替；锁点冲刺后90%继续、10%短暂跌落
本体触碰：24
注意事项：地下半径与接触伤均为0、通常免伤；出土位置直接设为玩家坐标，随后立即恢复普通接触伤24。
源码位置：js/bosses.js:7994–8326；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.5137255, 0.7176471, 0.9490196, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_24"), SubResource("sub_61"), SubResource("sub_98"), SubResource("sub_135")])
entity_settings = SubResource("sub_1")
