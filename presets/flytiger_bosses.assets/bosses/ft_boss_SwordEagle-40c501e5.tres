[resource]
script = ExtResource("ext_9")
id = "ft_boss_SwordEagle"
title = "铁鹰"
description = "来源：Boss总览 / 阶段与转换，源码类 SwordEagle。
出现条件：通用地图池；基础权重3，见过后权重减半
阶段结构：单血；通用30%狂暴标记
招式组合：9/3羽毛疏密交替、双向螺旋旋风、限转向追踪冲锋
移动：fight高速游弋；羽毛齐射与定时旋风/突袭状态切换
本体触碰：20
注意事项：突袭以2.5rad/s限制转向；不是每帧直接贴住玩家。
源码位置：js/bosses.js:399–556；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.9137255, 0.5921569, 0.40392157, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_31")])
entity_settings = SubResource("sub_1")
