[resource]
script = ExtResource("ext_9")
id = "ft_summoned_ft_enemy_leigong"
title = "雷公"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B21:K21。
分类：飞行精英
攻击模式：玩家x落雷／双柱夹击
弹丸/攻击对象：Lightning
行为状态机与移动逻辑：飞至屏幕右侧约W−200后上下漂浮；周期记录玩家x放纵向落雷
自然出场/召唤条件：自然池：击败3个Boss后
基础接触伤害：18
出场保护/免疫：无
实现说明：第4轮起2柱：玩家x与随机±90px；雷线发出后位置固定。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
color = Color(1, 0.9137255, 0.5254902, 1)
start_position = Vector2(280, -80)
phases = Array[ExtResource("ext_2")]([SubResource("sub_38")])
entity_settings = SubResource("sub_1")
