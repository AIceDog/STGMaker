[resource]
script = ExtResource("ext_9")
id = "ft_boss_AssassinKing"
title = "刺客之王"
description = "来源：Boss总览 / 阶段与转换，源码类 AssassinKing。
出现条件：仙人洞（cave）限定；普通模式仅Boss序号5/7/11/13（注册早轮forceChance被此限制过滤）
阶段结构：每条血满bMax；第四血后4.2s回收插突袭再进第五血；P6终章可计时死亡
招式组合：狐火扇、分身、点冲、锁路、追踪爆裂狐火、斩击、泪滴、旋转激光、四向大卡与尖刺轨迹
移动：五条血；试探/猎杀循环→距离随机战→王猎与回收→腐化头→四激光/四向卡
本体触碰：24
注意事项：按实际可达状态统计：P4每招结束立即转P3、回P4重置p4n，所以常规只发fullfire；斩击spawnSlash未设置x/y，命中计算NaN，当前不产生配置斩伤；爪墙/墙锯没有生成入口。
源码位置：js/bosses.js:13308–14968；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.5137255, 0.7176471, 0.9490196, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_17"), SubResource("sub_110"), SubResource("sub_175"), SubResource("sub_184"), SubResource("sub_235"), SubResource("sub_251"), SubResource("sub_267")])
entity_settings = SubResource("sub_1")
