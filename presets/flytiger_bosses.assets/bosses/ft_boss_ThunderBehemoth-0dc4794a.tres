[resource]
script = ExtResource("ext_9")
id = "ft_boss_ThunderBehemoth"
title = "雷公巨兽"
description = "来源：Boss总览 / 阶段与转换，源码类 ThunderBehemoth。
出现条件：通用地图池；基础权重3，见过后权重减半
阶段结构：单血；≤30%改狂暴攻击
招式组合：纵向3柱→横向2线→X斜雷；狂暴3道竖雷
移动：右侧缓慢游弋；常态3招按atkMode轮换，狂暴改竖雷
本体触碰：24
注意事项：狂暴不是常态3招叠加：常态发射被!enraged条件关闭。
源码位置：js/bosses.js:206–290；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.5137255, 0.7176471, 0.9490196, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_24"), SubResource("sub_33")])
entity_settings = SubResource("sub_1")
