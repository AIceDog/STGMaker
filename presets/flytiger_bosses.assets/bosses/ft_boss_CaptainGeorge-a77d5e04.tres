[resource]
script = ExtResource("ext_9")
id = "ft_boss_CaptainGeorge"
title = "乔治船长"
description = "来源：Boss总览 / 阶段与转换，源码类 CaptainGeorge。
出现条件：大海（ocean）限定；本局首次90%首秀掷骰，见过后普通池
阶段结构：单血；≤30%加快并增炮数
招式组合：三/五路炮弹、一轮双连发、弯曲俯冲
移动：炮击→贝塞尔俯冲→右上复返→炮击固定循环
本体触碰：24
注意事项：炮弹没有配置shellBlast，不应当视为通用shell爆炸弹。蓝水花仅视觉。
源码位置：js/bosses.js:8696–8917；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.5137255, 0.7176471, 0.9490196, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_24")])
entity_settings = SubResource("sub_1")
