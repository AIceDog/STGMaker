script = ExtResource("ext_2")
id = "ft_boss_skill_035"
title = "斧王 · 斧击突进"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 41 行。
源码类：BossMan
阶段与可达性：第二命内P5
组合数量：本体
弹丸 / 机关：接触
运动：锁玩家方向720px/s突0.5s或触边，缓动归位≤0.7s
时序：接在电击之后
伤害口径：接触32×A
备注：狂暴混合：3斧→16液→电击→突进循环
源码位置：js/bosses.js:1854–1911
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
