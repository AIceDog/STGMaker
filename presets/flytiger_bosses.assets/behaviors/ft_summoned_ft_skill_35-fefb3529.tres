[resource]
script = ExtResource("ext_2")
id = "ft_summoned_ft_skill_35"
title = "双头飞蛇 · 双头交叉连射"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B41:N41。
招式：双头交叉连射
每轮数量：8
弹丸样式：orb + eb:diamond紫菱形
弹道与瞄准逻辑：左右头从x±20同时发射，各按玩家坐标+头部偏移计算角度；每对重新瞄准
初始速度(px/s)：240
触发条件/重复节奏：每轮4对、对间0.22s；轮次2.4–3.2s
前摇/预警：无
判定半径/宽度(px)：6
弹丸寿命/有效期(s)：5
伤害与特殊效果：14×A
实现说明：一轮4对不是4发；左右头并非交替发射；清晰紫色光带。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
