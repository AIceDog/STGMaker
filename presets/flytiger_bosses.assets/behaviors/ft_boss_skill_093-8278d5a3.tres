[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_093"
title = "火龙将军 · 低→高→低火焰斩【仅视觉，无伤害】"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 99 行。
源码类：FireDragonGeneral
阶段与可达性：B1远距
组合数量：3发
弹丸 / 机关：fireSlash
运动：锁当次玩家方向420px/s，出手y偏+40/−50/+40
时序：judge0.5s；每0.6s一发，结束等0.8s
伤害口径：配置20×A；r32、3.5s；专属碰撞；当前noTouch且缺自管hurt，实际无命中扣血
备注：noTouch跳过Game碰撞；entities的此kind更新仅粒子/轨迹，未补hurt判定。
源码位置：js/bosses.js:7667–7689
【仅视觉】源码缺少有效命中入口，模板不会补造伤害。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_7")])
