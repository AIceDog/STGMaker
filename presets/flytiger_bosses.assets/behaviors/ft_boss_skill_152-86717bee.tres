[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_152"
title = "靓星 · 海星圆环与错角双环"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 158 行。
源码类：LiangStar
阶段与可达性：P1
组合数量：平时14；每第3轮14+14
弹丸 / 机关：小海星Actor
运动：平时160；双环168/132px/s，第二圈偏π/14
时序：首1.1s后每2.15s，双圈错0.34s
伤害口径：12×A；r13、5s
备注：金粉拖尾、自旋海星，主环不是空心环实体而是14颗子弹
源码位置：js/bosses.js:12786–12826、13045–13064
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_7")])
