[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_160"
title = "刺客之王 · 递宽狐火扇"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 166 行。
源码类：AssassinKing
阶段与可达性：P1
组合数量：5+5+6
弹丸 / 机关：狐火Actor
运动：速度290/300/310；总幅0.56/0.84/1.16rad；锁首瞄角
时序：0/0.5/1.0s三组；1.9s结束
伤害口径：13×A；r9、5s
备注：同一次出招的三组发射源坐标固定
源码位置：js/bosses.js:13828–13839、13651–13666
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_7")])
