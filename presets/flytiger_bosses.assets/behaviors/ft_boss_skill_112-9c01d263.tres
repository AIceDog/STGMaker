[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_112"
title = "雪巫 · 大小冰环交替"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 118 行。
源码类：SnowWitch
阶段与可达性：ring/c2
组合数量：大→小循环
弹丸 / 机关：icering
运动：大外/内58/35，小43/24；水平向左；发射y锁玩家±48
时序：大环后隔1.16/1.34s，小环后0.64/0.48s
伤害口径：12×A；9s；大速160/116，小280/352
备注：空心环带判定，中心可穿；发出后不追踪
源码位置：js/bosses.js:9267–9281、9311–9327、9355–9365
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
