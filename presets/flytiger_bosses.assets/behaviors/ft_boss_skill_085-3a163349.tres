[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_085"
title = "巨型骨龙王 · 骨蛇与分裂骨龙组"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 91 行。
源码类：BoneDragonKing
阶段与可达性：崩解组
组合数量：额外2骨蛇；组分批1/2/3…
弹丸 / 机关：GrassDragon(bone) / BoneDragonMini
运动：骨蛇和强化小段各使用独立敌人AI；组从左/右/上入屏
时序：头碎立即2蛇；组初1.5s等待，全灭后继续
伤害口径：召唤物各自攻击和接触伤
备注：组剩余血是Boss崩解血条；组清空才进B
源码位置：js/bosses.js:6551–6695；js/entities.js:BoneDragonMini、GrassDragon
【模板适配边界】召唤复用现有小骨龙行为，草骨龙暂用同一攻击逻辑演示；召唤群共享血条 / 首领伤害转发需宿主实现。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
