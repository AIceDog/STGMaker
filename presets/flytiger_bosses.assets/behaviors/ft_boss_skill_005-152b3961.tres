[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_005"
title = "雷公巨兽 · X形斜闪电"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 11 行。
源码类：ThunderBehemoth
阶段与可达性：常态
组合数量：2线
弹丸 / 机关：Lightning
运动：以玩家点为交叉中心，方向±随机0.6..0.78rad，宽76px
时序：同轮换节奏，0.95s预警
伤害口径：round(22×A)／线
备注：不是会飞行的雷球
源码位置：js/bosses.js:251–255
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
