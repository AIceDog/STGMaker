[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_082"
title = "牛魔 · 落地冲击＋上喷碎片"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 88 行。
源码类：NiuMo
阶段与可达性：B4
组合数量：1大环＋12发
弹丸 / 机关：环 / 刺球Actor
运动：环520px/s、R980带36；上方1.7rad扇280
时序：落地首次到位
伤害口径：环16×A；碎片13×A、r12
备注：落地后2.4s开始追加双眼扫射
源码位置：js/bosses.js:6004–6028
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
