[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_139"
title = "西海王 · 强化触手五式轮换"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 145 行。
源码类：SeaKing
阶段与可达性：P4
组合数量：长短5；中央3+3；侧4+顶3；顶4+底4；左右5+5
弹丸 / 机关：触手Actor
运动：长330–585，错峰0.14..0.17，左右延0.55/0.35、横纵延0.8
时序：每2.4s，首轮longShort
伤害口径：16×A；0.6s冷却
备注：两侧中央封锁保留上下通路；纵向对涌也是实体危险
源码位置：js/bosses.js:11707–11721、11738–11786
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_11")])
