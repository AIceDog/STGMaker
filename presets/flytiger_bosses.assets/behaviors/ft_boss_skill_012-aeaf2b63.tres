[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_012"
title = "铁鹰 · 限转向突袭"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 18 行。
源码类：SwordEagle
阶段与可达性：rush
组合数量：本体
弹丸 / 机关：接触+白色移动尾迹
运动：320px/s；最多2.5rad/s追踪转向，边界镜面反弹
时序：0.5s前摇，持续3.8s
伤害口径：接触20×A
备注：移动尾迹为视觉，不单独造成伤害
源码位置：js/bosses.js:482–510
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
