id = "ft_boss_skill_185"
title = "刺客之王 · 爪墙/墙锯/地面冲击【预留，手动预览】"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 191 行。
源码类：AssassinKing
阶段与可达性：预留，未有生成入口
组合数量：当前没有正常生成
弹丸 / 机关：walls / wallSaws / shocks
运动：walls仅有更新/渲染；wallSaws移动vx、2.6s；墙落地可创建shock
时序：未查到walls.push或wallSaws.push
伤害口径：墙锯配置16×A，shock18×A；当前通常不出现
备注：登记为未接入逻辑，避免把文件头P5/P6介绍当作已实现攻击
源码位置：js/bosses.js:14530–14564、14615–14628
【未接入】不会进入 Boss 默认行为，仅保留独立可编辑预览。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
