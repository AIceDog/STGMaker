[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_045"
title = "鹤仙 · 三层声波圈"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 51 行。
源码类：CraneSage
阶段与可达性：P1鹤鸣
组合数量：24→14→24发
弹丸 / 机关：wave
运动：每层均分圆周、错位0.21rad；速度150/210/280
时序：首层0.7s，层间0.55s，动作3.2s
伤害口径：11×A；中层r15，其余r13；7s
备注：声波是离散弹丸，非连续实心圈
源码位置：js/bosses.js:2691–2708
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_7")])
