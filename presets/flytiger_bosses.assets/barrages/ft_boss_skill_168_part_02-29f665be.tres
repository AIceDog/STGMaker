[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_168_part_02"
title = "刺客之王 · 近战连杀组合 · 发射 2"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 174 行。
源码类：AssassinKing
阶段与可达性：P2
组合数量：突刺→扇斩→后撤3弹→环斩
弹丸 / 机关：身体 / 狐火 / Slash
运动：冲760；退260并瞄玩家3发260、角差0.25
时序：冲蓄0.5/飞0.4/停0.15；扇0.75→退0.55→环1.2s
伤害口径：冲30×A；3火11×A、r8；斩目前不命中
备注：链招仍推进；环/扇缺坐标问题不影响狐火/突刺
源码位置：js/bosses.js:13975–14008
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
