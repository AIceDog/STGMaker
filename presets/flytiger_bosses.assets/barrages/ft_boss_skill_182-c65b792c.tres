[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_182"
title = "刺客之王 · 持续腐化泪滴"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 188 行。
源码类：AssassinKing
阶段与可达性：P5
组合数量：每0.22s一颗
弹丸 / 机关：Tear Actor
运动：70%近垂直vy130–200；30%斜vx±100–170/vy60–120
时序：贯穿tears/laser两子段
伤害口径：12×A；r8、6s
备注：P6更新不再spawnTear；非追踪或重力弹
源码位置：js/bosses.js:14267–14306、14432–14445
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
