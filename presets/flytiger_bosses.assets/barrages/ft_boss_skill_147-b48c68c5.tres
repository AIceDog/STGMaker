[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_147"
title = "西海王 · 追踪卡牌"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 153 行。
源码类：SeaKing
阶段与可达性：P8/P9
组合数量：P8三张延0/0.55/1.1；P9两/一张
弹丸 / 机关：卡牌Actor
运动：R150以1.6公转1s→0.32s实时锁点→520px/s直飞；持续留水流
时序：P8每3.3s轮到卡牌；P9组合每2.5s
伤害口径：卡14×A，0.7s冷却；水流10×A
备注：“追踪”是发射前锁点，飞行后不导向
源码位置：js/bosses.js:12090–12125、12188–12190、12222–12239
【模板适配边界】卡片绕行后锁定一次再直飞；水迹需组合第 151 条。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_24")
