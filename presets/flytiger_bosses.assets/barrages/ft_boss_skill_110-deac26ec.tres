[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_110"
title = "深海恶霸 · 直角铁钩＋铁链"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 116 行。
源码类：SeaBully
阶段与可达性：fight/climax
组合数量：1钩及锚点链
弹丸 / 机关：whook
运动：水平左飞600/742px/s→在x150转90°随机上/下→直飞→1050回收；与手部锚点链相连
时序：蓄0.62/0.4s；转向0.3/0.2s；高潮每2.1s出钩
伤害口径：钩/链16×A；钩中绑定玩家拖480px后释放（无敌期仍可被钩）
备注：头每钩只抓一次；绷直链才伤，转弯/回收链无伤；已被拖不再吃链伤
源码位置：js/bosses.js:9098–9120；js/entities.js:1309–1355、1511–1596
【模板适配边界】钩子去回轨迹可编辑；拖动玩家及持续链条碰撞需宿主接入。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_14")
