[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_080_part_01"
title = "牛魔 · 脱离手臂贯穿 · 发射 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 86 行。
源码类：NiuMo
阶段与可达性：B4
组合数量：2次右手，末端8碎片＋环
弹丸 / 机关：手臂Actor / 刺球 / 环
运动：脱臂0.45s→线预警0.7s→1080px/s贯穿950→返回
时序：冲臂段0.9/5.3s
伤害口径：拳20×A；碎片12×A；末端环14×A
备注：B2存在同函数但当前时间线未调用
源码位置：js/bosses.js:5522–5540、5698–5740、5981–5982
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
