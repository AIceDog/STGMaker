[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_006_part_02"
title = "雷公巨兽 · 竖雷夹击 · 发射 2"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 12 行。
源码类：ThunderBehemoth
阶段与可达性：狂暴
组合数量：玩家头顶1道+随机左右2道
弹丸 / 机关：Lightning
运动：中柱宽84、侧柱60；侧偏随机130..280px
时序：2.2–2.8s；0.95s预警
伤害口径：round(16×A)／柱
备注：侧柱各自随机选侧，未保证一左一右
源码位置：js/bosses.js:261–271
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
