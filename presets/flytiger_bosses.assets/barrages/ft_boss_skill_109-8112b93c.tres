[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_109"
title = "深海恶霸 · 抛掷深海炸弹"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 115 行。
源码类：SeaBully
阶段与可达性：fight
组合数量：1弹→3层波＋核心
弹丸 / 机关：wbomb
运动：锁玩家点，1.18s弹道、重力820；到点爆炸
时序：0/0.13/0.26s错层波
伤害口径：核心14×A一次；3层环带22各14×A一次（受无敌帧限制）
备注：noTouch，抛物途中不走普通子弹圆碰撞
源码位置：js/bosses.js:9073–9096；js/entities.js:1449–1510
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
