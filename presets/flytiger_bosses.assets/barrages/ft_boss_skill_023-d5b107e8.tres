[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_023"
title = "怒星使 · 三束扇形激光"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 29 行。
源码类：Homelander
阶段与可达性：beam3
组合数量：3束，角差0.26rad
弹丸 / 机关：Beam
运动：瞄准出手时玩家，长度1400、宽15
时序：0.8sBeam预警；动作停留2s
伤害口径：round(17×A)／束
备注：rockBreak=true，激活时毁沿路山石
源码位置：js/bosses.js:1032–1040、1123–1128
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
