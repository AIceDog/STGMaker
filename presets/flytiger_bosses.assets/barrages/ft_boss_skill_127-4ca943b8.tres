[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_127"
title = "花和尚 · 无敌肉球弹跳与喷弹"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 133 行。
源码类：FlowerMonk
阶段与可达性：P1/P3组合/P4
组合数量：P1=4；组合=6；P4=2；每球3–5弹
弹丸 / 机关：FlowerBall / orb
运动：水平60–120，重力900，上下/边界反弹；朝上0.32rad间隔扇200–260
时序：肉球升起0.625s；喷弹初1.6–3.2后2.2–3.6s
伤害口径：球接触16×A；orb9×A、r6、3.2s
备注：肉球视觉直径扩大1.5倍；子弹命中爆圈纯视觉
源码位置：js/bosses.js:10428–10550、10621–10628、10967–10987、11037–11044
【模板适配边界】复用现有花球攻击行为；花球不受伤、重力反弹与地面适配需宿主接入。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_4")
