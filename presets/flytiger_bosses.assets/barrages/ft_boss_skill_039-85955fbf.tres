[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_039"
title = "怪客 · 召唤雷公"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 45 行。
源码类：Stranger
阶段与可达性：fight第4招
组合数量：3只
弹丸 / 机关：Enemy leigong
运动：0.3s后首只，间隔0.32s，走spawnEnemy入口
时序：招后2.8–3.6s
伤害口径：小怪纵向落雷；原参数随round加强
备注：仍受spawnEnemy总数上限，但不经pickEnemyType同型限1检查
源码位置：js/bosses.js:2198–2205；js/entities.js:6427–6442
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_4")
