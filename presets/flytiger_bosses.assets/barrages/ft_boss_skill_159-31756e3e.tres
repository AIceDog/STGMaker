[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_159"
title = "靓星 · 追踪→加速离场卡"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 165 行。
源码类：LiangStar
阶段与可达性：各卡牌攻击
组合数量：上限24
弹丸 / 机关：卡牌Actor
运动：236px/s、转向3.7rad/s追2.3s→当前方向加速260px/s²到430、最多1.5s
时序：按各发射源延迟；卡发出后可多次命中
伤害口径：14×A，r判定30+玩家半径，0.7s冷却
备注：卡拖尾粒子纯视觉，不留下西海王式水流
源码位置：js/bosses.js:13105–13156
【模板适配边界】追踪 2.3 秒后用固定 430 速度演示加速终段。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_14")
