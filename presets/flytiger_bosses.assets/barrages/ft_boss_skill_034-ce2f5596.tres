[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_034"
title = "斧王 · 抛酒壶＋酒液散射"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 40 行。
源码类：BossMan
阶段与可达性：第二命内P3/P4/P5
组合数量：1壶→8液；狂暴16液
弹丸 / 机关：potbomb / liquid
运动：抛物线T1.2s、g520；液体环弹普通180±20、狂暴230±20
时序：酒壶1.8–2.4s及换位；落地/撞玩家/到期炸
伤害口径：壶爆16×A近区，外区60%；液9×A；R90/130
备注：酒壶是绿色碎液与棕壶样式；液弹寿命4s
源码位置：js/bosses.js:1762–1810、1985–2017；js/entities.js:905–923
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
