script = ExtResource("ext_6")
id = "ft_boss_skill_007"
title = "赤鬼 · 手里剑扇射"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 13 行。
源码类：Samurai
阶段与可达性：fight
组合数量：7发，间距0.13rad
弹丸 / 机关：shuriken
运动：300px/s，发射时瞄准玩家
时序：1.9–2.4s
伤害口径：12×A；r9、寿命6s
备注：旋转外观不等于曲线飞行
源码位置：js/bosses.js:320–331
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
