[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_055"
title = "狮身人面像 · 贴地外扩地波"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 61 行。
源码类：Sphinx
阶段与可达性：P1
组合数量：每落爪1圈
弹丸 / 机关：自定义hazard
运动：横向外扩430px/s，只在地面附近高度带伤人
时序：随落爪；R上限620、寿命1.45s
伤害口径：14×A，单圈一次
备注：飞高可避；不是实心圆爆炸
源码位置：js/bosses.js:3623–3645
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
