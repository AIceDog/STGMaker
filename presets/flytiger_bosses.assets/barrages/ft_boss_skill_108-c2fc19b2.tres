[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_108"
title = "深海恶霸 · 水鲨追猎"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 114 行。
源码类：SeaBully
阶段与可达性：fight/climax
组合数量：常态1、狂暴2–3
弹丸 / 机关：wshark
运动：先巡航0.55s，再以1.9/3.1rad/s转向追玩家；速度248/312
时序：蓄0.62/0.4s，招间0.55–1.05/0.32–0.7s；高潮7s，每0.95s出2鲨
伤害口径：12×A；r12、6.5s
备注：水鲨有专属实体，非召唤敌人
源码位置：js/bosses.js:9044–9071；js/config.js:seaBully
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
