[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_158_part_03"
title = "靓星 · 各头独立海星环与卡 · 发射 3"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 164 行。
源码类：LiangStar
阶段与可达性：P4/P5头群
组合数量：P4每头8环＋1卡；P5每头10环＋1或2卡
弹丸 / 机关：海星头 / 小海星 / 卡牌
运动：P4环150、P5环170；固定锚点轻摆，受伤可暂时离场
时序：P4环2.9−0.9×损血比+奇数头0.45；卡4.4−1.4×损血比+奇数头0.6；P5环2/2.4、卡2.7/3.2
伤害口径：头接触16×A（0.8s冷却）；环12×A、卡14×A
备注：仅settle态发射；P5 50%几率追加卡延0.2；离场/返回无接触伤
源码位置：js/bosses.js:12932–13043
【模板适配边界】独立头部发射原点演示；可击破的头部实体与共享血量需宿主实现。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
