[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_149_b02"
title = "西海王 · 四种高速组合 · 弹体 3"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 155 行。
源码类：SeaKing
阶段与可达性：P9
组合数量：头＋戟→戟＋2卡→触/头/戟/卡→触＋2卡
弹丸 / 机关：混合器官
运动：头820、戟720/740；卡520；触长350/390
时序：每2.5s；第2次回combo0时改终局蓄冲
伤害口径：按载体伤害；本体34×A
备注：首combo1；四机制齐发组中器官仍有各自延迟
源码位置：js/bosses.js:12195–12245
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(60, 45)
