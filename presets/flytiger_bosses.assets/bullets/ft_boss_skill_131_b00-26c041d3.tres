[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_131_b00"
title = "花和尚 · 肉球延时爆炸 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 137 行。
源码类：FlowerMonk
阶段与可达性：P3/P4终章前
组合数量：P3波数按atkCycle选2/2/3；终章1大球
弹丸 / 机关：FlowerBall
运动：球固定，无敌；升起后倒计时爆圆，半径H×0.125..0.15
时序：P3每0.5s一球，预警0.9；终章1.1s
伤害口径：中心24×A；外围14.4×A（再round）；球接触16×A
备注：P3 atkCycle从P1继承，未保证首次从2球开始；blastR是半径，注释称25..30%H为直径
源码位置：js/bosses.js:10464–10481、10869–10889、11076–11084
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
form = "area"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(162, 162)
