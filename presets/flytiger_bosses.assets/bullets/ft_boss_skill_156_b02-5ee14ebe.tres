[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_156_b02"
title = "靓星 · 本体加压环弹与卡 · 弹体 3"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 162 行。
源码类：LiangStar
阶段与可达性：P4
组合数量：血≥50%=12，<50%=14，<33%再12；卡1/2
弹丸 / 机关：小海星 / 卡牌
运动：主环165，补环130随机起角；卡第二延0.25
时序：环间隔2.5−0.95×损血比；卡4.3−1.5×损血比
伤害口径：环13×A；卡14×A
备注：两计时器并行，与头群各自弹幕叠加
源码位置：js/bosses.js:12878–12903
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(60, 60)
