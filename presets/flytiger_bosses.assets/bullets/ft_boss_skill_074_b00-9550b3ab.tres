[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_074_b00"
title = "牛魔 · 定点爆炸刺球 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 80 行。
源码类：NiuMo
阶段与可达性：B1/B2/B3
组合数量：B1 2/2/3颗；组合段2颗
弹丸 / 机关：大刺球→环＋10小刺球
运动：340到玩家附近点→停0.85s→10片195–235与环300R175
时序：分段锚点投放
伤害口径：大球16×A；碎片12×A；环13×A
备注：停顿中的大球仍可碰撞；空心环单次伤
源码位置：js/bosses.js:5273–5356、5420–5432、5590–5594、5889–5895
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(48, 48)
