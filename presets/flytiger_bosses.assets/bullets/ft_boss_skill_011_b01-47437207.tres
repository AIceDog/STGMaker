[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_011_b01"
title = "铁鹰 · 旋转双向弹幕 · 弹体 2"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 17 行。
源码类：SwordEagle
阶段与可达性：whirl
组合数量：每0.09s发2颗对向
弹丸 / 机关：whirl
运动：基角按9rad/s旋转，150px/s直线外扩
时序：持续3s；重复8–10s
伤害口径：12×A；r8、寿命7s
备注：形成螺旋发射图案；每颗弹并未绕Boss持续旋转
源码位置：js/bosses.js:468–479
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(16, 16)
