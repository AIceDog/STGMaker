[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_046_b00"
title = "鹤仙 · 顶部锁点下落＋落地环弹 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 52 行。
源码类：CraneSage
阶段与可达性：P1俯冲
组合数量：本体→8发wave
弹丸 / 机关：接触 / wave
运动：升到屏外，跟踪x瞄0.85s，向下780px/s；落地8向250px/s
时序：升空约0.9s＋瞄0.85s
伤害口径：俯冲contact=round(26×A)，通用再×A；落环12×A
备注：落地恢复contact=20；落环3s
源码位置：js/bosses.js:2710–2744；js/entities.js:5305–5307
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(20, 20)
