[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_153_b01"
title = "靓星 · 本体换位环＋多中心环 · 弹体 2"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 159 行。
源码类：LiangStar
阶段与可达性：P2
组合数量：本体12；3漩涡各8
弹丸 / 机关：小海星Actor / 漩涡
运动：本体156；漩涡142px/s、随机起角
时序：本体每2.7s换位出环；各漩涡2.6s出8
伤害口径：本体12×A、r13；漩涡弹11×A、r10
备注：P1后半0.45/0.62窗口先生2漩涡，P2补第3
源码位置：js/bosses.js:12803–12843、13065–13104
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(20, 20)
