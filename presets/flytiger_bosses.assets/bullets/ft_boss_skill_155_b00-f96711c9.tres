[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_155_b00"
title = "靓星 · 卡牌增量＋10海星环 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 161 行。
源码类：LiangStar
阶段与可达性：P3
组合数量：卡1→2→3；环10
弹丸 / 机关：卡牌Actor / 小海星
运动：环150px/s随机起角；卡持续追踪
时序：每2.35s；卡错0.18s；P2末0.55/0.8窗口已混卡
伤害口径：环12×A，卡14×A
备注：相比西海王卡牌，此卡飞行中真的追踪
源码位置：js/bosses.js:12837–12862、13105–13156
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(26, 26)
