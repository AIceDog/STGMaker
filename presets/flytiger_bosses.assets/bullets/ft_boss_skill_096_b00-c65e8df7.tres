[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_096_b00"
title = "火龙将军 · 交替移动火柱【仅视觉，无伤害】 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 102 行。
源码类：FireDragonGeneral
阶段与可达性：B2
组合数量：3柱
弹丸 / 机关：firePillar
运动：左右交替向对侧220px/s，地面出生，竖向专属范围
时序：名义每0.8s一柱，结束等1.5s（计时双加）
伤害口径：配置18×A；r30、4s；当前noTouch且缺自管hurt，实际无命中扣血
备注：noTouch跳过Game碰撞；entities的此kind更新仅粒子/轨迹，未补hurt判定。
源码位置：js/bosses.js:7794–7818
【仅视觉】源码缺少有效命中入口，模板不会补造伤害。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(60, 60)
