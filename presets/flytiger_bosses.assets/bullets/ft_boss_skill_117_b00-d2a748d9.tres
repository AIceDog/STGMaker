[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_117_b00"
title = "鸦伯爵 · 层叠折返宝石扇 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 123 行。
源码类：CrowCount
阶段与可达性：回旋
组合数量：5–7发；狂暴加1
弹丸 / 机关：gem ret
运动：朝玩家所在左右侧，扇幅0.4rad；前飞到170..430±12依次折返
时序：各tier停0.1/0.2/0.32s，狂暴减半；折返速度基190×1.9
伤害口径：13×A；9s
备注：62%小、20%中、18%大，末发保底至少1大；返程专属变向
源码位置：js/bosses.js:9785–9809；js/entities.js:1356–1413、1598–1622
【模板适配边界】去回轨迹演示使用尾段追踪玩家；源码回收目标是 Boss，需要宿主挂载。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(36, 36)
