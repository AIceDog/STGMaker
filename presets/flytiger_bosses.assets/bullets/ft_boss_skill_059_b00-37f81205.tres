[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_059_b00"
title = "狮身人面像 · 四路点冲锋与尾刃 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 65 行。
源码类：Sphinx
阶段与可达性：P3冲撞
组合数量：本体＋每轮3月牙
弹丸 / 机关：身体 / crescent
运动：中→左→右→中600px/s；尾尖瞄准3发280–330px/s扇射
时序：冲锋段5s，尾刃每0.28s
伤害口径：接触30×A；尾刃15×A、r12、4.5s
备注：尾刃只在movingDir非0时发射
源码位置：js/bosses.js:3764–3784
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(24, 24)
