[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_051_b00"
title = "鹤仙 · 双龙卷风 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 57 行。
源码类：CraneSage
阶段与可达性：P2
组合数量：2漏斗
弹丸 / 机关：自定义tornado
运动：贴地高300px，上宽半径48、下14；65px/s蛇形横移，边界反弹
时序：蓄转约0.6s后生成；持续9s
伤害口径：14×A；每0.5s可再次触发
备注：顶上留空间；漏斗形区域碰撞，不是Bullet
源码位置：js/bosses.js:2844–2855、2944–2987
【模板适配边界】移动龙卷与重复命中已配置；边界反弹使用宿主控制。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(60, 300)
