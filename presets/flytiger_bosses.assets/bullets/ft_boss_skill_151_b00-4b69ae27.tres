[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_151_b00"
title = "西海王 · 持久水流轨迹 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 157 行。
源码类：SeaKing
阶段与可达性：三叉戟/卡牌/冲刺残留
组合数量：路径连续落段
弹丸 / 机关：水流Actor
运动：固定胶囊：戟小段34×34寿2.2/2.6，旋扫长404×0.62宽30寿1.7，卡34×32寿1.6
时序：戟直冲每0.045s；旋扫0.09；卡0.06；冲刺每帧
伤害口径：10×A／段，0.55s冷却
备注：换阶段和吸收未清trails；器官视觉圈rings无伤
源码位置：js/bosses.js:12004–12070、12113–12116、12281–12283
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(34, 34)
