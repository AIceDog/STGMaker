[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_018_b00"
title = "飞天狗王 · 收肢激光 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 24 行。
源码类：DogKing
阶段与可达性：P2
组合数量：每收回一肢1束
弹丸 / 机关：Beam
运动：从肢体锚点瞄准当时玩家，长1250、宽30px
时序：肢体回收完成后；Beam预警0.7s
伤害口径：round(20×A)，激活时一次
备注：激光不跟随肢体/玩家继续转向
源码位置：js/bosses.js:770–775
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
form = "laser"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(1250, 30)
