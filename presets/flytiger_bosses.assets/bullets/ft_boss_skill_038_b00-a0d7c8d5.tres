[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_038_b00"
title = "怪客 · 巨型追踪十字／回血 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 44 行。
源码类：Stranger
阶段与可达性：cross
组合数量：1发
弹丸 / 机关：cross
运动：初始260；先追击，靠近后绕边框一圈；快速旋转
时序：0.7s准备；寿命12s
伤害口径：22×A；成功命中回血最大生命20%，每次招最多一次
备注：此kind有专门追踪/边框逻辑，不依赖homing字段
源码位置：js/bosses.js:2242–2266；js/entities.js:cross更新
【模板适配边界】追踪十字已配置；受击治愈 Boss 需宿主回调。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(36, 36)
