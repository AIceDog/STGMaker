[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_118_b00"
title = "鸦伯爵 · 上抛封路宝石 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 124 行。
源码类：CrowCount
阶段与可达性：回旋
组合数量：2发小/中
弹丸 / 机关：gem lob
运动：0.95s抛到地面，重力1000；玩家x±70/130，狂暴加vx×0.35预判
时序：检测到折返开始才投，间隔0.22s；7s兜底结束
伤害口径：13×A；6s
备注：不是落地爆炸，落地即消失
源码位置：js/bosses.js:9707–9719、9811–9828
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(24, 24)
