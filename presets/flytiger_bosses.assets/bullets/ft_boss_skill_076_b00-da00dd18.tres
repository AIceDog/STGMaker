[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_076_b00"
title = "牛魔 · 螺旋回收刺球 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 82 行。
源码类：NiuMo
阶段与可达性：B1吸球
组合数量：场上全部非fade球
弹丸 / 机关：刺球Actor
运动：以3rad/s绕本体、560..1060px/s收缩半径
时序：38–42s；血空提前开始
伤害口径：原球伤害保留、0.7s冷却
备注：吸收阶段仍会伤玩家；被吸球使本体膨胀，不按球数回血
源码位置：js/bosses.js:5318–5330、5452–5463
【模板适配边界】用一组样例尖刺演示旋转收回；未把场上任意旧实例统一吸回。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(30, 30)
