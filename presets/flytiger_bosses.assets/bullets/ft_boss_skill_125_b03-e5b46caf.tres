[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_125_b03"
title = "紫手 · 角落符卡夹击 · 弹体 4"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 131 行。
源码类：PurpleHand
阶段与可达性：B
组合数量：4/6张，各3弹
弹丸 / 机关：purpleFan / 固定卡片
运动：每卡朝玩家±0.21rad三路255px/s
时序：预警1.15/0.85s，依次错开0.34/0.26s
伤害口径：11×A；r9
备注：卡片是发射源；B结束清卡并回A
源码位置：js/bosses.js:10289–10359
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
