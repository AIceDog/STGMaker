[resource]
script = ExtResource("ext_3")
id = "ft_bullet_flowerball_neon"
title = "花和尚无敌肉球 · 霓虹方弹"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），弹丸样式 B9:G9。
样式名称：普通像素方弹
使用者：飞天骷髅、花和尚肉球
实际外观与拖尾：黑边方弹+白高光；默认红#ff6b6b；骨白/橙色或玫红/青色按color覆盖
弹道/特殊交互：直线；环弹/扇射只是发射角组合；肉球弹附霓虹粒子尾
判定与视觉差异：圆形r=5/6，与方形视觉不同"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(12, 12)
