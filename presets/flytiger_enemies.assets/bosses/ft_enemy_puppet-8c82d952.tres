[resource]
script = ExtResource("ext_9")
id = "ft_enemy_puppet"
title = "皮影客"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B17:K17。
分类：角斗场地面
攻击模式：对齐玩家／竖直上投飞刀
弹丸/攻击对象：orb + eb:dart
行为状态机与移动逻辑：hunt：地面左右追齐玩家x，x钳制50..W−40；持续向正上方投刀
自然出场/召唤条件：自然池：击败3个Boss后；仅罗马角斗场/月痕沙海解锁
基础接触伤害：10
出场保护/免疫：出场1.2s
实现说明：刀带极小水平修正clamp(Δx×0.12,−50,50)，发射后不追踪；groundOff未参与站位。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
攻击模板固定发射点以便检查上抛弹道；原游戏地面 135px/s 跟随玩家 x 属于持续移动 AI。"
color = Color(0.87058824, 0.84313726, 0.9411765, 1)
start_position = Vector2(220, 200)
phases = Array[ExtResource("ext_2")]([SubResource("sub_24")])
entity_settings = SubResource("sub_1")
