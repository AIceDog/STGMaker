[resource]
script = ExtResource("ext_9")
id = "ft_enemy_eagle"
title = "飞鹰"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B7:K7。
分类：常规飞行
攻击模式：锁点俯冲／横向扫场
弹丸/攻击对象：无弹丸
行为状态机与移动逻辑：enter → hover → windup → dive → recover → hover；50%长冲分支直接向左扫出场
自然出场/召唤条件：自然池：击败0个Boss后
基础接触伤害：12
出场保护/免疫：无
实现说明：hover等待阈值每帧重新随机；短俯冲1.6s或触地后脱离，长冲前0.45s下坠再拉平。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
攻击模板悬停取 2 秒固定值；短冲恢复后再选择。长冲实际关卡由左边界回收，孤立攻击预览没有关卡边界调度。"
color = Color(0.9137255, 0.8, 0.54509807, 1)
start_position = Vector2(300, -140)
phases = Array[ExtResource("ext_2")]([SubResource("sub_32")])
entity_settings = SubResource("sub_1")
