[resource]
script = ExtResource("ext_9")
id = "ft_enemy_superboy"
title = "小超人"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B20:K20。
分类：常规飞行
攻击模式：预警单束激光
弹丸/攻击对象：Beam
行为状态机与移动逻辑：保持玩家右侧约280px、上方60px；进入x<W−20后发射锁定方向的预警光束
自然出场/召唤条件：自然池：击败2个Boss后
基础接触伤害：14
出场保护/免疫：出场7s
实现说明：光束伤害在预警结束瞬间仅判一次；光路可炸毁山石，山石不能遮挡此光束。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
color = Color(1, 0.47058824, 0.43137255, 1)
start_position = Vector2(240, -100)
phases = Array[ExtResource("ext_2")]([SubResource("sub_17")])
entity_settings = SubResource("sub_1")
