[resource]
script = ExtResource("ext_2")
id = "ft_skill_13"
title = "羊头斗士 · 助跑跳跃撞击"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B19:N19。
招式：助跑跳跃撞击
每轮数量：无
弹丸样式：本体+白气拖尾
弹道与瞄准逻辑：助跑持续跟踪；起跳固定朝目标左右；水平260、初始vy=−700，g=1500
初始速度(px/s)：行走92；助跑250（均×speedMul）
触发条件/重复节奏：首轮2–3s后助跑；后续回中线再助跑
前摇/预警：0.55s助跑
判定半径/宽度(px)：本体30px
弹丸寿命/有效期(s)：直到落地
伤害与特殊效果：空中接触30×A；地面12×A
实现说明：碰撞调用通用接触规则，仍可能被角色自动技能/无敌帧处理。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
