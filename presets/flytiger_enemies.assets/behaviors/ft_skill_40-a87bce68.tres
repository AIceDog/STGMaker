[resource]
script = ExtResource("ext_2")
id = "ft_skill_40"
title = "花和尚无敌肉球 · 下方反弹碰撞"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B46:N46。
招式：下方反弹碰撞
每轮数量：无
弹丸样式：肉球精灵
弹道与瞄准逻辑：左右壁反弹；g=900；下边反弹vy=−|vy|×0.92−随机60..160；上边向下
初始速度(px/s)：初始vx=±60..120；vy=−200..−320
触发条件/重复节奏：升起0.625s后运动，Boss存活期间循环
前摇/预警：升起动画
判定半径/宽度(px)：随Boss招式×1.5后的半径
弹丸寿命/有效期(s)：至Boss清球/死亡/自爆
伤害与特殊效果：接触16×A
实现说明：完全无敌机关，代码isBoss=true；上界位于H×0.6−r。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
编辑器使用下方往返测试路径与基准半径 40px；原游戏重力 900、速度随机/墙面反弹和 Boss 按招式放大半径需要宿主机关接入。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
