[resource]
script = ExtResource("ext_2")
id = "ft_skill_03"
title = "蝙蝠 · 波浪群袭"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B9:N9。
招式：波浪群袭
每轮数量：无
弹丸样式：无
弹道与瞄准逻辑：右侧逼近，随玩家高度移动，叠加sin(t×7)波动
初始速度(px/s)：190×speedMul（不同轴另乘系数）
触发条件/重复节奏：持续；群体3–5只／0.22s错峰
前摇/预警：无
判定半径/宽度(px)：本体13px
弹丸寿命/有效期(s)：直到击杀/离屏
伤害与特殊效果：接触8×A
实现说明：无射击计时，无弹丸。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
此招式只演示单只蝙蝠身体波浪路径；3–5 只/0.22 秒由关卡编队配置，跟随玩家高度属于敌人持续 AI。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
