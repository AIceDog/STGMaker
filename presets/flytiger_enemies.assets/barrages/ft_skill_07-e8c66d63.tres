[resource]
script = ExtResource("ext_6")
id = "ft_skill_07"
title = "飞天骷髅 · 旋转5路扇形"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B13:N13。
招式：旋转5路扇形
每轮数量：5
弹丸样式：orb骨白方弹#e8eef7
弹道与瞄准逻辑：rotA±0.48rad；相邻0.24rad；基角按1.6rad/s转动
初始速度(px/s)：220
触发条件/重复节奏：独立fanT=2.6–3.4s；仅x>W−30
前摇/预警：无
判定半径/宽度(px)：5
弹丸寿命/有效期(s)：6
伤害与特殊效果：12×A
实现说明：并非瞄准玩家的5路扇射，使用旋转基角。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
