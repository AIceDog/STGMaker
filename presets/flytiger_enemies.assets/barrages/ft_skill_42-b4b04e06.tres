[resource]
script = ExtResource("ext_6")
id = "ft_skill_42"
title = "花和尚无敌肉球 · 停球预警自爆"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B48:N48。
招式：停球预警自爆
每轮数量：无
弹丸样式：玫红闪光/范围虚线圈
弹道与瞄准逻辑：Boss指令设置explodeT；预警期间停止移动及射击，倒计时后爆炸移除
初始速度(px/s)：非飞行弹
触发条件/重复节奏：花和尚P3①、P4终段
前摇/预警：P3=0.9s；P4=1.1s
判定半径/宽度(px)：P3=67.5–81；P4=81
弹丸寿命/有效期(s)：瞬时
伤害与特殊效果：近区round(24×A)，远区round(14.4×A)
实现说明：近区阈值0.55R；只能由Boss内部逻辑移除，不接受外部die。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
默认 P4：预警 1.1 秒、半径 81。P3 可改为预警 0.9 秒、半径 67.5–81。仅作为 Boss 外部指令调用，普通机关循环不自动触发。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
