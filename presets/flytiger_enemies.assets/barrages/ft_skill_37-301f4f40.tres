[resource]
script = ExtResource("ext_6")
id = "ft_skill_37"
title = "龙系分裂小段 · 分裂小段露头扇射"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B43:N43。
招式：分裂小段露头扇射
每轮数量：6
弹丸样式：主题刺弹（7种，见龙系主题）
弹道与瞄准逻辑：每轮朝玩家发3路（−0.15/0/+0.15rad）；直线
初始速度(px/s)：430
触发条件/重复节奏：露头0.3s首轮、再隔0.7s第二轮；surface共1.5s
前摇/预警：出土扬尘
判定半径/宽度(px)：弹6；节基准11
弹丸寿命/有效期(s)：5
伤害与特殊效果：每弹max(1,round(12×A/3))
实现说明：两轮共6发；射完再空中穿梭5–8s，下钻后重新循环。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
默认选择草龙 spike 样式；其他龙主题是宿主外观变体，沿用同一速度、三路角度与两轮间隔。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
