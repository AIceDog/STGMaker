[resource]
script = ExtResource("ext_6")
id = "ft_skill_20"
title = "斧头兵 · 死亡旋转飞天/落地爆炸"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B26:N26。
招式：死亡旋转飞天/落地爆炸
每轮数量：无
弹丸样式：本体旋转+落地爆炸
弹道与瞄准逻辑：死亡vy=−780、vx随机±70；g=1500；落回restY时爆
初始速度(px/s)：非飞行弹
触发条件/重复节奏：hp耗尽后立即开始；奖励已结算
前摇/预警：死亡飞行演出
判定半径/宽度(px)：96
弹丸寿命/有效期(s)：直到落地
伤害与特殊效果：近区round(12×A)，远区round(7.2×A)
实现说明：期间dying=true、不可接触/受伤；旋转速度±13rad/s。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
基准预览固定向右 70px/s；到原高度的飞行时间 1.04 秒。死亡期间不启用身体攻击。原游戏随机左右旋转/奖励结算由宿主死亡表现接入。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
