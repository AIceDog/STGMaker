[resource]
script = ExtResource("ext_6")
id = "ft_skill_04"
title = "飞天恶魔 · 瞄准单发/3路扇射"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B10:N10。
招式：瞄准单发/3路扇射
每轮数量：1；第3轮起3
弹丸样式：spark紫色方弹
弹道与瞄准逻辑：发射时朝玩家；3路角偏移−0.22/0/+0.22rad
初始速度(px/s)：230
触发条件/重复节奏：2–2.8s；第3轮起×0.85；x<W−40
前摇/预警：无
判定半径/宽度(px)：6
弹丸寿命/有效期(s)：7
伤害与特殊效果：每弹10×A
实现说明：单发与3路同一shootAt入口；飞行中不追踪。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
独立招式预览为第 3 轮后的 3 路版本；敌人流程的前两次发射覆盖 count=1。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
