[resource]
script = ExtResource("ext_6")
id = "ft_skill_41"
title = "花和尚无敌肉球 · 向上霓虹扇射"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B47:N47。
招式：向上霓虹扇射
每轮数量：3–5
弹丸样式：orb玫红/青色方弹
弹道与瞄准逻辑：正上方扇形，相邻角度0.32rad；不瞄准玩家
初始速度(px/s)：每发随机200–260
触发条件/重复节奏：初次1.6–3.2s；以后2.2–3.6s
前摇/预警：无
判定半径/宽度(px)：6
弹丸寿命/有效期(s)：3.2
伤害与特殊效果：round(9×A)
实现说明：命中仅追加爆炸视觉，未追加范围伤害；自定义霓虹粒子尾。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
模板默认 4 发，数量可编辑为 3–5；每发速度随机 200–260。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
