[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_100"
title = "癫狂鬣狗 · 钻地追踪出土"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 106 行。
源码类：MadHyena
阶段与可达性：burrow
组合数量：一次
弹丸 / 机关：身体
运动：潜地追玩家x，出土结束瞬移到玩家(x,y)
时序：70/40/10%各一次
伤害口径：实际碰撞普通24×A
备注：代码先设30但onDashHit立刻恢复24；无独立出土AOE
源码位置：js/bosses.js:8169–8216
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
