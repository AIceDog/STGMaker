[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_026"
title = "怒星使 · 落地冲刺"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 32 行。
源码类：Homelander
阶段与可达性：land/dash
组合数量：本体
弹丸 / 机关：接触
运动：锁当时玩家低空位置；vx由680、vy由320投影，低空钳制
时序：落地0.85s；冲≤0.95s或到x<80；退1.1s
伤害口径：接触28×A
备注：并不是完整恒速680向量
源码位置：js/bosses.js:1042–1065
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
