[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_142"
title = "西海王 · 克隆多头点冲"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 148 行。
源码类：SeaKing
阶段与可达性：P2/P5/P7/P8/P9
组合数量：P2左右2；P5斜2/左右上3；P8/9一头
弹丸 / 机关：克隆头Actor
运动：持续瞄0.6s后锁方向；速度700/820/760；错峰0..1.6s
时序：P5四式3.1s；其他按时间线/组合
伤害口径：18×A；0.7s冷却；仅dash碰撞
备注：器官不可杀；不走主Boss接触24/34/40
源码位置：js/bosses.js:11855–11929、12127–12144、12181–12183、12226–12239
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_7")])
