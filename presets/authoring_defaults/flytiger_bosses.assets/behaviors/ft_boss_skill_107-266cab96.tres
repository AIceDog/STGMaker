[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_107"
title = "乔治船长 · 大弧俯冲"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 113 行。
源码类：CaptainGeorge
阶段与可达性：dive
组合数量：本体1次
弹丸 / 机关：身体
运动：锁点时刻玩家方向决定出口y，控制点随机大弯；参数速度480/660
时序：先停0.5/0.36s
伤害口径：冲刺30×A；普通24×A
备注：贝塞尔估算弧长决定用时，瞬时速度并非常数
源码位置：js/bosses.js:8800–8861
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
