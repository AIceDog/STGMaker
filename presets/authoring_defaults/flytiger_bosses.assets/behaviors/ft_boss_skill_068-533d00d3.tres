[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_068"
title = "牛魔 · 旋转缺口魔气环"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 74 行。
源码类：NiuMo
阶段与可达性：A-P2/P3
组合数量：采样18/18/20/20或终章24，缺口跳过
弹丸 / 机关：qi
运动：P2 195–225px/s；终章240；按ringRot方向留1rad缺口（非实时瞄玩家）
时序：P2 9.2/10.4/11.6/12.8s，P3终章
伤害口径：13/14×A；终章15×A；r10/11
备注：实际弹数少于采样数
源码位置：js/bosses.js:4519–4729、4730–4878
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_9")])
