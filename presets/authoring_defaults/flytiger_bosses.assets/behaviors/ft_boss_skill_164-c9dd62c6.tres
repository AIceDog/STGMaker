[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_164"
title = "刺客之王 · 上下双波封锁"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 170 行。
源码类：AssassinKing
阶段与可达性：P2
组合数量：每波6横坐标×上下两发，按缺口跳过
弹丸 / 机关：狐火Actor
运动：x140..740每120；上向下230、下向上−230；第二270
时序：0/0.95s两波，子段2.3s
伤害口径：13×A；r9
备注：跳abs(x−玩家x)<50，但若落在采样间缝，可能不减任何弹；不是连续墙
源码位置：js/bosses.js:13898–13916
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
