[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_077"
title = "牛魔 · 交替砸地"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 83 行。
源码类：NiuMo
阶段与可达性：B2
组合数量：6次，每落点1环＋7碎片（265px/s、幅1.5rad）
弹丸 / 机关：手臂Actor / 环 / 刺球
运动：左右轮换锁地面点，拳头快速落下
时序：0.8+i×2.35s，预警0.72s
伤害口径：拳18×A；环14×A；碎片12×A
备注：拳接触只在0.72..0.95s；拳冷却0.8s
源码位置：js/bosses.js:5504–5513、5560–5564、5640–5686、5765–5772
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_17")])
