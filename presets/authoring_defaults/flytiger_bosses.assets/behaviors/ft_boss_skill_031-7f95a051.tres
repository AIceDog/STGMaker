[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_031"
title = "斧王 · 双眼S弧激光"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 37 行。
源码类：BossMan
阶段与可达性：第一命P2
组合数量：2条
弹丸 / 机关：CurveBeam
运动：双眼射向屏幕左边随机y；曲线幅110–210，宽16
时序：3.2–4s；预警1s，激活0.45s
伤害口径：round(18×A)
备注：不是普通直线Beam，曲线按路径分段检测
源码位置：js/bosses.js:1337–1363；js/entities.js:4247–4340
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
