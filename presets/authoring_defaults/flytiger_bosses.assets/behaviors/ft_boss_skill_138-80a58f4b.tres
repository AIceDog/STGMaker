[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_138"
title = "西海王 · 基础触手五式轮换"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 144 行。
源码类：SeaKing
阶段与可达性：P1
组合数量：右面4→左右4+4→夹击2+2→顶面4→左面4
弹丸 / 机关：触手Actor
运动：侧波长350–545，顶250/300；先错峰再1500px/s伸出，hold0.6后2200收回
时序：每2.6s；错峰0.16/0.18；左右交叠延0.72
伤害口径：16×A；双根各胶囊、0.6s冷却
备注：首轮volley++先waveR；触手回收期无伤
源码位置：js/bosses.js:11653–11737、11752–11786
【模板适配边界】仅触手前伸尖端判伤，停留 / 回收不判伤；触手实体连接线由宿主显示。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_9")])
