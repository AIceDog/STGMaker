[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_084"
title = "巨型骨龙王 · 分节追踪与点冲"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 90 行。
源码类：BoneDragonKing
阶段与可达性：完全体
组合数量：头＋200身体节
弹丸 / 机关：身体
运动：常飞220，冲520固定方向0.9s；地下700跟玩家x
时序：冲刺计时初2.5–4.5s、后3–5s，到时每帧60%尝试
伤害口径：头26×A、完整身体10×A
备注：地下未露出节不可碰撞；免冰冻
源码位置：js/bosses.js:6397–6451、6766–6865
【模板适配边界】仅头部身体移动；201 段龙身、掩埋碰撞及伤害共享需要宿主实体。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
