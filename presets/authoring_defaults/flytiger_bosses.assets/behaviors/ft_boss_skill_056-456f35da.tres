[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_056"
title = "狮身人面像 · 双眼左右扫射"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 62 行。
源码类：Sphinx
阶段与可达性：P2
组合数量：每0.32s两束
弹丸 / 机关：Beam
运动：玩家方向锁角后扫±1.1rad，长度1500、宽12
时序：子段先蓄0.7s，Beam自身预警0.42s
伤害口径：15×A／束
备注：前3s正向扫、后3s反向扫
源码位置：js/bosses.js:3711–3730、3591–3593
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
