[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_180"
title = "刺客之王 · 连锁影袭＋真冲＋环【预留，手动预览】"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 186 行。
源码类：AssassinKing
阶段与可达性：P4预留，常规不可达
组合数量：2影→真冲900→环r115
弹丸 / 机关：Shadow / 身体 / Slash
运动：影780左右对冲；真冲蓄0.55/飞0.45/停0.2
时序：影延0/0.65，1.35s真冲
伤害口径：影16×A、冲30×A、环配置22但不命中
备注：p4n不选；若手动进入，chainring子状态无独立分发，需阶段上限兜底
源码位置：js/bosses.js:14211–14226
【未接入】不会进入 Boss 默认行为，仅保留独立可编辑预览。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
