[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_143"
title = "西海王 · 双侧交叉喷水"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 149 行。
源码类：SeaKing
阶段与可达性：P5/P7
组合数量：左右各5发
弹丸 / 机关：水弹Actor
运动：各侧当前玩家高度±40；290px/s，幅0.7rad
时序：P5四式3.1s；P7=6.8s
伤害口径：13×A；r11、3.4s
备注：发射后不跟踪
源码位置：js/bosses.js:11800–11812、11886–11888、12135
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
