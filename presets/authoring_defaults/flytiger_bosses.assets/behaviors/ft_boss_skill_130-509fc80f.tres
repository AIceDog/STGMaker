[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_130"
title = "花和尚 · 双侧巨刃夹击"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 136 行。
源码类：FlowerMonk
阶段与可达性：P2
组合数量：2把
弹丸 / 机关：光刃Actor
运动：长0.45W厚0.12H；左右各300，高度错开
时序：蓄0.4s，等两刃消失
伤害口径：22×A
备注：注释说中央安全，但实际刃向中央连续穿越，不能视为永久静态安全区
源码位置：js/bosses.js:10815–10829
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
