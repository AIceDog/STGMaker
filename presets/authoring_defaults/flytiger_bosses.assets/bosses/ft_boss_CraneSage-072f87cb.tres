[resource]
script = ExtResource("ext_9")
id = "ft_boss_CraneSage"
title = "鹤仙"
description = "来源：Boss总览 / 阶段与转换，源码类 CraneSage。
出现条件：通用地图池；基础权重3，见过后权重减半
阶段结构：2血；第一血空回满并锁血10s；第二血空死亡
招式组合：追踪羽针、三层声波、俯冲落环、环绕羽领域、全屏落羽；风炮、镜子折射、龙卷与风刃
移动：第一血4招轮换，半血插万羽天葬；血空转10s锁血风炮，再循环镜面反射/双龙卷/风刃/速射/瞬移
本体触碰：20
注意事项：P2镜面可被友弹击碎（10下），但折射第二段实际瞄准玩家，不按镜面法线作物理反射。
源码位置：js/bosses.js:2505–3390；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.7019608, 0.5803922, 0.9372549, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_38"), SubResource("sub_75"), SubResource("sub_112")])
entity_settings = SubResource("sub_1")
