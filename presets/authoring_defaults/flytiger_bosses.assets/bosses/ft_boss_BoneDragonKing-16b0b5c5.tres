[resource]
script = ExtResource("ext_9")
id = "ft_boss_BoneDragonKing"
title = "巨型骨龙王"
description = "来源：Boss总览 / 阶段与转换，源码类 BoneDragonKing。
出现条件：紫色荒地（wasteland）限定；普通模式仅Boss序号5/7/11/13（注册早轮forceChance被此限制过滤）
阶段结构：头血→分裂组总血→B1满头血→B2满头血→B3半头血
招式组合：绿火扇、龙体冲刺、骨蛇召唤、扩张骨环、横扫骨脊、终相扑击
移动：201节龙体出土追击→头碎分裂组→灵魂B1→巨颅B2→完整灵魂B3
本体触碰：26
注意事项：完全体身体受70%并锁1血，向头传导实际40%（注释部分写50%）；地下露出判定限制命中；免疫冰冻。
源码位置：js/bosses.js:6282–7346；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.7019608, 0.5803922, 0.9372549, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_24"), SubResource("sub_33"), SubResource("sub_49"), SubResource("sub_65"), SubResource("sub_102")])
entity_settings = SubResource("sub_1")
