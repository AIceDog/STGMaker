[sub_resource type="Resource" id="sub_128"]
script = ExtResource("ext_2")
title = "火龙 B2"
life = 3
entry_mode = "sequence"
behavior_flow = SubResource("sub_127")

[resource]
script = ExtResource("ext_9")
id = "ft_boss_FireDragonGeneral"
title = "火龙将军"
description = "来源：Boss总览 / 阶段与转换，源码类 FireDragonGeneral。
出现条件：火焰山（volcano）限定；普通模式仅Boss序号5/7/11/13（注册早轮forceChance被此限制过滤）
阶段结构：头血→火龙组总血→人形B1满头血→B2满血
招式组合：红火扇、喷火、火龙分裂、三连火斩、跳踢、半圆回旋斩、移动火柱、斩落爆炸
移动：继承骨龙分节/崩解系统；红火龙→火龙组→人形距离格斗→火龙风暴
本体触碰：28
注意事项：与骨龙不是换皮同招：人形B阶段完全重写。B入场提前设fight，bInvulnT未在takeDamage核查，宣称10s无敌实际只保证入场；B2子函数额外累加stateT，名义5s锁血约2.5s。；人形火斩与火柱均noTouch=true，Bullet更新仅处理视觉，没有自管伤害，所以当前不会扣玩家血。
源码位置：js/bosses.js:7347–7993；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.9137255, 0.5921569, 0.40392157, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_17"), SubResource("sub_26"), SubResource("sub_77"), SubResource("sub_128")])
entity_settings = SubResource("sub_1")
