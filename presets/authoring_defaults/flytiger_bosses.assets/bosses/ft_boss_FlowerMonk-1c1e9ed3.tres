[resource]
script = ExtResource("ext_9")
id = "ft_boss_FlowerMonk"
title = "花和尚"
description = "来源：Boss总览 / 阶段与转换，源码类 FlowerMonk。
出现条件：霓虹喵都（cyber）限定；普通模式仅Boss序号5/7/11/13（注册早轮forceChance被此限制过滤）
阶段结构：第一血P1/P2循环→锁5s满血P3→第三血70%P4
招式组合：肉球喷弹/爆炸、横扫/抛射/夹击光刃、格挡刃环、全向刃、光谱涨潮
移动：赛博肉球与和尚交替→强化五招→最终狂暴；场地底光谱/顶刺常驻
本体触碰：26
注意事项：肉球虽isBoss=true，但未注册独立Boss；完全无敌且伤害不转发。P4 atkCycle仅ring6结束递增：不是注释所写简单四招两轮，达到8才终章且下一sub可能跳过前面招。
源码位置：js/bosses.js:10551–11444；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.5137255, 0.7176471, 0.9490196, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_17"), SubResource("sub_47"), SubResource("sub_84"), SubResource("sub_114")])
entity_settings = SubResource("sub_1")
