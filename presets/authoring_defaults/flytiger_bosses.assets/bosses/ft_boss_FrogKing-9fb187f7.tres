[resource]
script = ExtResource("ext_9")
id = "ft_boss_FrogKing"
title = "蛙哥"
description = "来源：Boss总览 / 阶段与转换，源码类 FrogKing。
出现条件：通用地图池；大海/群山除外；基础权重3，见过后权重减半
阶段结构：单血；通用30%狂暴标记
招式组合：大跳、前方爪击、全屏长舌拉拽、蓄力冲撞
移动：地面大跳追击；落地按距离和冷却优先选爪击、卷舌、冲撞
本体触碰：20
注意事项：舌头扫到后即卷住并拉玩家；不要求hurt返回成功才设置grabbed。
源码位置：js/bosses.js:2286–2504；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.5137255, 0.7176471, 0.9490196, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_45")])
entity_settings = SubResource("sub_1")
