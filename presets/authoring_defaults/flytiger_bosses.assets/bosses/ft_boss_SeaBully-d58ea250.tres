[resource]
script = ExtResource("ext_9")
id = "ft_boss_SeaBully"
title = "深海恶霸"
description = "来源：Boss总览 / 阶段与转换，源码类 SeaBully。
出现条件：海底（seabed）限定；本局首次90%首秀掷骰，见过后普通池
阶段结构：单血；66%高潮；≤30%加速
招式组合：追踪水鲨、延时爆炸、多段铁钩与围猎组合
移动：随机水鲨/炸弹/钩；慢速跟随高度；66%插入一次围猎
本体触碰：
注意事项：本体接触伤0；避免重复只重抽一次，所以仍可能连续同招。
源码位置：js/bosses.js:8918–9161；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.7019608, 0.5803922, 0.9372549, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_24"), SubResource("sub_47")])
entity_settings = SubResource("sub_1")
