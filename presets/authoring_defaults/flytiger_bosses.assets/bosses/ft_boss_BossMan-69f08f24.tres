[resource]
script = ExtResource("ext_9")
id = "ft_boss_BossMan"
title = "斧王"
description = "来源：Boss总览 / 阶段与转换，源码类 BossMan。
出现条件：通用地图池；群山除外；基础权重3，见过后权重减半
阶段结构：2命；第一命50%转巨头；第二命火车→电击→酒壶→混合→35%狂暴
招式组合：召唤斧兵、追踪漂浮斧、手部连斧、16斧环、S弧眼激光；第二命飞斧/电击/酒壶/突进
移动：第一命人形交替漂浮斧与双手齐射→半血巨头；血空后上火车开始第二命多招序列
本体触碰：32
注意事项：开场6s锁血；斧击命中可叠无敌；火车5部件可被敌斧或玩家弹击毁。第二命的内部P1–P5与外层phase=3分开标注。
源码位置：js/bosses.js:1165–2152；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.7019608, 0.5803922, 0.9372549, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_38"), SubResource("sub_68"), SubResource("sub_91"), SubResource("sub_128")])
entity_settings = SubResource("sub_1")
