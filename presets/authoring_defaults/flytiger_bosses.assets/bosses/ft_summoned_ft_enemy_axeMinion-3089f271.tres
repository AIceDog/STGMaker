[resource]
script = ExtResource("ext_9")
id = "ft_summoned_ft_enemy_axeMinion"
title = "斧头兵"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B19:K19。
分类：Boss召唤地面
攻击模式：高弧抛斧／死亡落地爆炸
弹丸/攻击对象：axe
行为状态机与移动逻辑：walk到按序分配的haltX → idle → throwAnim → idle；死亡另走deathFly直到落地爆炸
自然出场/召唤条件：斧王开场专属召唤（12只，间隔0.38s），不进入自然池
基础接触伤害：8
出场保护/免疫：出场0.6s；死亡演出不可受伤
实现说明：斧王开场12只，0.38s错峰；奖励在死亡起飞时结算，落地才清除实体。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
死亡技能单独挂载，普通投斧循环不会主动播放死亡飞行或落地爆炸。"
on_death_behavior_id = "ft_summoned_ft_skill_20_death_behavior"
color = Color(0.68235296, 0.75686276, 0.8156863, 1)
start_position = Vector2(270, 200)
phases = Array[ExtResource("ext_2")]([SubResource("sub_31")])
entity_settings = SubResource("sub_1")
