[resource]
script = ExtResource("ext_9")
id = "ft_boss_Sphinx"
title = "狮身人面像"
description = "来源：Boss总览 / 阶段与转换，源码类 Sphinx。
出现条件：沙漠（desert）限定；普通模式仅Boss序号5/7/11/13（注册早轮forceChance被此限制过滤）
阶段结构：3循环；阶段可按时间自然推进；血空提前跳阶段，P1/P2跳到下阶段回60%，P3结束前两循环回满
招式组合：爪碎片/地波、双眼扫光、三眼光、缺口神眼环、冲撞尾刃、双螺旋与终章混合
移动：P1双爪→P2神眼→P3狂怒；每3阶段一循环，循环3次
本体触碰：26
注意事项：不是普通单条血Boss；自然P1/P2时间到也会推进，无需耗尽血。第三循环P3自然结束亦判击败。
源码位置：js/bosses.js:3391–4290；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.9137255, 0.5921569, 0.40392157, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_17"), SubResource("sub_33"), SubResource("sub_77"), SubResource("sub_93"), SubResource("sub_109"), SubResource("sub_153"), SubResource("sub_169"), SubResource("sub_185"), SubResource("sub_229")])
entity_settings = SubResource("sub_1")
