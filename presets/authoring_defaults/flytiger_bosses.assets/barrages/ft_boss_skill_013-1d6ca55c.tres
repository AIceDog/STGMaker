[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_013"
title = "亡灵骷髅王 · 骷髅狙击"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 19 行。
源码类：SkullKing
阶段与可达性：fight
组合数量：1发
弹丸 / 机关：skull
运动：285px/s，发射时瞄准
时序：每0.7s；初次0.8s
伤害口径：12×A；r12、6s
备注：骷髅旋转与弧形青绿尾迹为样式
源码位置：js/bosses.js:586–595
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
