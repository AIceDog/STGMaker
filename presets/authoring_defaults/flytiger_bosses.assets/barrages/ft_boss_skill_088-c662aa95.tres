[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_088"
title = "巨型骨龙王 · 全屏骨脊鞭"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 94 行。
源码类：BoneDragonKing
阶段与可达性：B2/B3
组合数量：1条
弹丸 / 机关：bonespine
运动：B2竖链660px/s水平扫；B3横链470px/s向下扫
时序：B2等鞭死亡或3.2s；B3驻顶后0.35s发
伤害口径：20×A；9s；链线专属碰撞
备注：noTouch关闭普通圆碰撞，不代表没有伤害
源码位置：js/bosses.js:6931–6944、7069–7075、7173–7180
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
