[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_047"
title = "鹤仙 · 环绕羽领域"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 53 行。
源码类：CraneSage
阶段与可达性：P1旋羽
组合数量：14羽
弹丸 / 机关：feather + orbit
运动：半径70起，90px/s扩张、2.2rad/s绕Boss；3s后沿切线飞散
时序：领域3s；弹寿命5s
伤害口径：11×A；r8
备注：orbit清除后保留切线速度，不自动全部消失
源码位置：js/bosses.js:2746–2753、2784–2795
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_14")
