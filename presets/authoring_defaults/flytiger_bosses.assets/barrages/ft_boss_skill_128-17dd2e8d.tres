[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_128"
title = "花和尚 · 巨型光刃横扫"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 134 行。
源码类：FlowerMonk
阶段与可达性：P2/P4
组合数量：P2两次，P4一把/子段
弹丸 / 机关：光刃Actor
运动：P2长度0.65W厚0.12H，240左右扫；P4 0.7W、320
时序：蓄0.5/0.4s；等刃全部消失再推进
伤害口径：P2 24×A；P4 26×A；刃矩形碰撞
备注：每刃dealt一次；第二次P2不同高度，P4按计数换高度/侧
源码位置：js/bosses.js:10786–10801、11013–11024、10639–10669
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
