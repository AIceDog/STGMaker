[resource]
script = ExtResource("ext_6")
id = "ft_summoned_ft_skill_38"
title = "小骨蛇／骨龙组 · 2路绿火连续狙击"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B44:N44。
招式：2路绿火连续狙击
每轮数量：2
弹丸样式：greenfire绿火白芯
弹道与瞄准逻辑：朝玩家方向±0.08rad，发射后直线
初始速度(px/s)：320
触发条件/重复节奏：每0.7s；atkT初始0，到位后可立即发
前摇/预警：无
判定半径/宽度(px)：7
弹丸寿命/有效期(s)：4
伤害与特殊效果：普通10×A；pack=12×A
实现说明：220px内以95px/s远离；entering时260px/s入场且不射击；免冰冻。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
