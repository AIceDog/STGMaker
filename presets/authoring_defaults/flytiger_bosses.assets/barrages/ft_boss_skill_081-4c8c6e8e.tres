[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_081"
title = "牛魔 · 双眼往返扫射"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 87 行。
源码类：NiuMo
阶段与可达性：B4
组合数量：每组2Beam
弹丸 / 机关：Beam
运动：长1600宽15；扫幅2.1rad，先锁向再正扫、重瞄后反扫
时序：每0.11s；每束预警0.22s；落地段每0.13s追加扫
伤害口径：18×A／束
备注：下一束改变角度，已发束不旋转
源码位置：js/bosses.js:5957–5961、5983–6003、6021–6028
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
