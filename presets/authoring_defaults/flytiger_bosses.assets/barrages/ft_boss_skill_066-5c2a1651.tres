script = ExtResource("ext_6")
id = "ft_boss_skill_066"
title = "牛魔 · 双角夹击"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 72 行。
源码类：NiuMo
阶段与可达性：A-P2
组合数量：2机关
弹丸 / 机关：角Actor
运动：玩家两侧±160，停0.55s后680px/s突进
时序：0.5s触发
伤害口径：15×A；r15
备注：悬停无伤
源码位置：js/bosses.js:4519–4729、4730–4878
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_14")
