[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_028_b00"
title = "斧王 · 巨大漂浮追踪斧 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 34 行。
源码类：BossMan
阶段与可达性：第一命P1
组合数量：5发
弹丸 / 机关：axe
运动：60px/s初射；缓追turnRate0.55，持续自旋
时序：3.4–4.2s交替招；弹命9s
伤害口径：18×A；hp=6次击中可爆，shellBlast R96
备注：不是一次6点血；玩家子弹每命中扣hp一次
源码位置：js/bosses.js:1281–1288、1435–1447
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(36, 36)
