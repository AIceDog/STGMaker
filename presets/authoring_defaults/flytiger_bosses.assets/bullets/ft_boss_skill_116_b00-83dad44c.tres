[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_116_b00"
title = "鸦伯爵 · 弱拍快速三小宝石 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 122 行。
源码类：CrowCount
阶段与可达性：飞掷
组合数量：3发r12
弹丸 / 机关：gem throw
运动：前段140×1.18px/s追玩家随机偏移71.5..130；离源280px后锁线400px/s
时序：弹距0.26/0.169s；整三拍重复2轮
伤害口径：13×A；8s
备注：弱拍完再蓄强拍，非始终连续连射；狂暴×1.22只乘前段速度，dash段为绝对accV。
源码位置：js/bosses.js:9695–9705、9770–9783
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(24, 24)
