[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_172_b00"
title = "刺客之王 · 双假影与真身金标突刺 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 178 行。
源码类：AssassinKing
阶段与可达性：P3中距
组合数量：2假影＋1本体
弹丸 / 机关：fakedash Shadow / 身体
运动：两假影720左右直冲；真身880锁点
时序：假影延0/0.55，各0.45s后移动；1.3s后真身蓄0.6
伤害口径：假影16×A，0.7s冷却；真冲30×A
备注：假影也有碰撞伤害；不是无害诱饵
源码位置：js/bosses.js:14087–14098、14453–14465
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(48, 48)
