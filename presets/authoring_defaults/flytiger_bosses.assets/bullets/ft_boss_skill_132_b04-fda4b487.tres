[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_132_b04"
title = "花和尚 · 自旋格挡缺口刃环 · 弹体 5"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 138 行。
源码类：FlowerMonk
阶段与可达性：P3
组合数量：8槽实际7→末0.6s补8，再飞1刃
弹丸 / 机关：刃环 / 光刃Actor
运动：R0.34H、刃长0.35H厚0.05H，公转0.9自转7；末刃380
时序：持续5.5s
伤害口径：环20×A、每刃0.7s冷却；末刃22×A
备注：环可销毁所有友方Bullet；最后0.6s取消缺口
源码位置：js/bosses.js:10890–10948
【模板适配边界】七把刀环绕演示；源码第八把补口、持续旋转刀的挡弹 / 反射玩家子弹需宿主接入。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(189, 27)
