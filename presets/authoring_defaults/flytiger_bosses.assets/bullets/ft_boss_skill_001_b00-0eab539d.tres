[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_001_b00"
title = "火焰飞猪王 · 三路大火球 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 7 行。
源码类：PigKing
阶段与可达性：fight
组合数量：3发，角差0.22rad
弹丸 / 机关：fireball
运动：185px/s，出手朝玩家，直线
时序：2.4–3.1s；初次2s
伤害口径：原弹18×A；到期14片flame及120px爆炸，碎片/范围伤13.5×A
备注：撞玩家走通用12片、90px爆炸；到期/越界走onExpire=14片
源码位置：js/bosses.js:133–139、180–187；js/game.js:2475–2489、3793–3796
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(28, 28)
