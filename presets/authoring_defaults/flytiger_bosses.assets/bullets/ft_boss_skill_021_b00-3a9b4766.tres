[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_021_b00"
title = "火鸡王 · 巨型追踪导弹 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 27 行。
源码类：GiantPheasant
阶段与可达性：fight
组合数量：1发
弹丸 / 机关：missile
运动：初始(120,−90)；homing，turnRate=2.3；尺寸×3
时序：3.4–4.4s；弹体前4s免拦截，寿命14s
伤害口径：18×A；引爆走shellBlast，R96近全/远60%
备注：hp=3次命中；onBreak与到期均爆，旋转剑可另行击爆
源码位置：js/bosses.js:891–902；js/game.js:3749–3774
【模板适配边界】导弹追踪与爆炸已配置；导弹独立 HP、前四秒免伤需接入玩家射击。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(28, 28)
