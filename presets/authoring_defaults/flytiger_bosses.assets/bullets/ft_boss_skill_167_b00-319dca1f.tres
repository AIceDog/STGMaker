id = "ft_boss_skill_167_b00"
title = "刺客之王 · 追猎爆裂狐火 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 173 行。
源码类：AssassinKing
阶段与可达性：P2/P3/过渡
组合数量：P2五；P3三；P1→2三
弹丸 / 机关：Homing Fire Actor
运动：250px/s、转向3.2rad/s；追1.5/2.1/2.4s后碎为6路200px/s
时序：P2每0.28s投1；P3同时3，2.6s子段
伤害口径：原13×A、r11；碎片10×A、r7；无独立爆炸范围伤
备注：到追踪时限爆裂；命中本体弹先移除，无碎片回调
源码位置：js/bosses.js:13569–13572、13667–13683、13964–13974、14054–14059、14407–14431
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(22, 22)
