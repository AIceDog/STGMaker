[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_042_b00"
title = "蛙哥 · 卷舌拉拽 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 48 行。
源码类：FrogKing
阶段与可达性：tongueOut
组合数量：一条舌身＋尖端
弹丸 / 机关：自定义舌线
运动：伸出1500、回收1300px/s，最大1.1×屏幕对角线；线距72以内卷住
时序：前摇0.3s；伸满停0.18s；冷却4.5–6s
伤害口径：round(8×A)，回收时每帧把玩家拉向嘴前40px
备注：伤害和抓住标记没有hurt成功门槛
源码位置：js/bosses.js:2374–2418
【模板适配边界】舌头作为预警线形攻击；抓取、拉回玩家需宿主回调。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
form = "laser"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(990, 72)
