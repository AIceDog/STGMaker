[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_101_b00"
title = "浣熊漫游者 · 危险足迹 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 107 行。
源码类：RaccoonRover
阶段与可达性：全路线
组合数量：每0.11s一枚，最多48
弹丸 / 机关：自定义marks
运动：当前位置y+42留下r21定点，寿命4s
时序：移动时持续铺设
伤害口径：13×A；触碰后该足迹移除
备注：不追踪、不飞行；入场也生成但仅fight更新命中
源码位置：js/bosses.js:8349–8364、8457–8471
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(42, 42)
