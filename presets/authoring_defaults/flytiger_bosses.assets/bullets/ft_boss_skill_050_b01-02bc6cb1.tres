[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_050_b01"
title = "鹤仙 · 镜面折射束 · 弹体 2"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 56 行。
源码类：CraneSage
阶段与可达性：P2
组合数量：最多同时2面镜→各2段光路
弹丸 / 机关：自定义beam
运动：Boss→镜；镜→当时玩家方向延900px
时序：子状态0.25s出束，0.7s预警+0.4s激活
伤害口径：16×A；线距11+玩家半径×0.7
备注：镜全部击碎可阻止反射束；每镜hp10次，破镜冲击圈纯视觉
源码位置：js/bosses.js:2991–3094
【模板适配边界】折线激光演示反射路径；镜子独立 HP 与真实反射点由宿主接入。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
form = "laser"
scene = ExtResource("ext_2")
visual = SubResource("sub_4")
collision = SubResource("sub_2")
beam_path = SubResource("sub_1")
beam_path_size = Vector2(1500, 22)
