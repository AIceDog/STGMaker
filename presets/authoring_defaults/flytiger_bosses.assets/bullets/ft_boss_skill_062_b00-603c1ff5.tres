[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_062_b00"
title = "狮身人面像 · 碎片→三眼→大环组合 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 68 行。
源码类：Sphinx
阶段与可达性：P3终章
组合数量：22碎片、3光束、16大菱形
弹丸 / 机关：shard / Beam / eyeGem
运动：碎片250–310px/s；束瞄玩家与±0.99rad；大环235px/s
时序：终章1.1s碎片、1.7s激光、2.3s环，3.6s收尾
伤害口径：碎片14×A；光18×A；环16×A、r16
备注：三种序列出手，可能同时残留；终章完推进循环/死亡
源码位置：js/bosses.js:3836–3866
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(20, 20)
