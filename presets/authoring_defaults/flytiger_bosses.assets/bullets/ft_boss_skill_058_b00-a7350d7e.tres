[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_058_b00"
title = "狮身人面像 · 旋转缺口神眼环 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 64 行。
源码类：Sphinx
阶段与可达性：P2/P3
组合数量：名义15/14点圆周，跳缺口
弹丸 / 机关：eyeGem
运动：185/200px/s，缺口角每轮缓转；缺口0.9/0.95rad
时序：P2=1.05s；P3=0.9s
伤害口径：13×A；r10、5s
备注：实际发数低于圆周采样点数
源码位置：js/bosses.js:3608–3618、3747–3754、3829–3834
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(20, 20)
