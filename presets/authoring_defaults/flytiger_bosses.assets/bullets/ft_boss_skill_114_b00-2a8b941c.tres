[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_114_b00"
title = "鸦伯爵 · 强拍大宝石 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 120 行。
源码类：CrowCount
阶段与可达性：飞掷
组合数量：1发大r48
弹丸 / 机关：gem throw
运动：前段140×0.72px/s，1.05rad/s转向追玩家+36px内固定偏移；离源280px后锁线520px/s（绝对值）
时序：蓄0.5/0.3s出大，2s后中拍
伤害口径：13×A；8s
备注：throw模式有限转向再锁线，速度详见gem专属更新；狂暴×1.22只乘前段速度，dash段为绝对accV。
源码位置：js/bosses.js:9735–9749；js/entities.js:1356–1413、1598–1622
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(96, 96)
