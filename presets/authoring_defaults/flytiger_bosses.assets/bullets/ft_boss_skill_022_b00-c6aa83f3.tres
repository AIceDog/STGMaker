[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_022_b00"
title = "火鸡王 · 弧形持续喷火 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 28 行。
源码类：GiantPheasant
阶段与可达性：fight
组合数量：区域判定，无弹丸
弹丸 / 机关：火焰粒子扇形
运动：每帧朝玩家；距离30..mouthX，半角0.55rad，覆盖左侧空域
时序：初始8s，后7–9.5s；持续2.8s
伤害口径：round(8×A)，反复hurt受无敌帧限制
备注：喷火粒子速度不是命中判定移动速度
源码位置：js/bosses.js:904–953
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
form = "area"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(900, 900)
