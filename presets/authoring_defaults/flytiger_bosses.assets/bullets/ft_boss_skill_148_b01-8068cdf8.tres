[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_148_b01"
title = "西海王 · 本体四机制轮换 · 弹体 2"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 154 行。
源码类：SeaKing
阶段与可达性：P8
组合数量：1头→1戟→3卡→2触手
弹丸 / 机关：混合器官
运动：头760、戟700；触长390/320、第二延0.35；本体维持距320
时序：首2.4s，之后3.3s一招
伤害口径：按载体伤害；本体34×A
备注：主触手根部在生成瞬间的Boss位置，非持续绑本体
源码位置：js/bosses.js:12157–12194
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(250, 30)
