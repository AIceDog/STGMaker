[resource]
script = ExtResource("ext_9")
id = "ft_enemy_firedragonmini"
title = "小火龙／火龙组"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B34:K34。
分类：Boss脱离／召唤体
攻击模式：持续2路红火狙击
弹丸/攻击对象：redfire
行为状态机与移动逻辑：入场移向指定点（若entering） → 220px内远离玩家 → 悬停微动并持续开火
自然出场/召唤条件：火龙将军断节；崩解时立即2只小火龙并生成每3节合并的火龙组
基础接触伤害：12；pack=16
出场保护/免疫：出场0.6s；免冰冻
实现说明：红火弹配置fireTrail=true，但redfire没有_renderBody分支：火焰粒子存在，弹体本身缺专用绘制。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
预览用距离分支演示远离后狙击；原游戏远离 95px/s 与悬停微动是持续 AI，不由此离散测试流程完整复刻。
默认普通型 10 伤害；pack=12，免冻结与 Boss 所属继承由宿主状态系统接入。"
color = Color(1, 0.4392157, 0.30588236, 1)
start_position = Vector2(380, -80)
phases = Array[ExtResource("ext_2")]([SubResource("sub_25")])
entity_settings = SubResource("sub_1")
