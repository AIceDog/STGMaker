[resource]
script = ExtResource("ext_9")
id = "ft_enemy_grassdragon_mini"
title = "龙系分裂小段"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B32:K32。
分类：龙系分裂体
攻击模式：2轮×3发主题扇射／身体碰撞
弹丸/攻击对象：spike等7种主题弹
行为状态机与移动逻辑：dive → burrow → moveX到玩家附近 → rise → surface → air → dive循环
自然出场/召唤条件：长身龙断节后生成；继承主题及bossOwned来源
基础接触伤害：16
出场保护/免疫：初始0.8s；出土时最多保留0.35s
实现说明：地下巡游1.6–2.8s；露头1.5s内最多2轮射击；空中5–8s后主动下钻。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
露头首发 0.3 秒、第二轮 1 秒、停到 1.5 秒后穿梭；不主动生成或删除其他龙段。"
color = Color(0.3882353, 0.8745098, 0.7294118, 1)
start_position = Vector2(180, 200)
phases = Array[ExtResource("ext_2")]([SubResource("sub_38")])
entity_settings = SubResource("sub_1")
