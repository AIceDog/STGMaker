[resource]
script = ExtResource("ext_9")
id = "ft_enemy_eyefly"
title = "魔眼飞虫"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B26:K26。
分类：弱型飞行弹幕
攻击模式：0.6s锁点／红眼珠弹
弹丸/攻击对象：orb + eb:eyeball
行为状态机与移动逻辑：玩家右侧约280px悬停；atk冷却 → lock持续更新玩家坐标 → 发射 → 冷却
自然出场/召唤条件：自然池：击败2个Boss后；弱档还须30%随机解锁
基础接触伤害：8
出场保护/免疫：出场1.5s
实现说明：锁定期间持续记录玩家位置，发射后直飞，不是飞行中追踪弹；动态血量目标7s。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
color = Color(0.92941177, 0.41960785, 0.46666667, 1)
start_position = Vector2(230, -60)
phases = Array[ExtResource("ext_2")]([SubResource("sub_24")])
entity_settings = SubResource("sub_1")
