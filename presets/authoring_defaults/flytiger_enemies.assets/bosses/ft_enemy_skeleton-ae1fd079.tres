[resource]
script = ExtResource("ext_9")
id = "ft_enemy_skeleton"
title = "自爆骷髅"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B10:K10。
分类：自爆飞行
攻击模式：停步预警后范围自爆
弹丸/攻击对象：无弹丸
行为状态机与移动逻辑：rush → chase → windup → detonate；冲至x<W×0.52后追击；进入150+玩家半径范围后停步
自然出场/召唤条件：自然池：击败1个Boss后
基础接触伤害：20
出场保护/免疫：出场5s
实现说明：触发后不再追踪位置；爆炸直接移除，走detonate而非die，无击杀奖励。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
测试流程用距离条件展示自爆；攻击预览循环重复展示。实际游戏自爆后直接 dead/无奖励与移除由宿主生命周期接入。追击段采用可编辑锁点移动，非原源码逐帧定速 AI。"
color = Color(1, 0.68235296, 0.40784314, 1)
start_position = Vector2(330, -40)
phases = Array[ExtResource("ext_2")]([SubResource("sub_25")])
entity_settings = SubResource("sub_1")
