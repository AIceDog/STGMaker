[resource]
script = ExtResource("ext_2")
id = "ft_skill_28"
title = "草龙 · 本体随机穿梭碰撞"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B34:N34。
招式：本体随机穿梭碰撞
每轮数量：无
弹丸样式：60节长龙
弹道与瞄准逻辑：空中40%弧线/30%90°/30%任意角转向；边界反射；触地高速钻入地下
初始速度(px/s)：空中155；垂直215；地下275（均×speedMul）
触发条件/重复节奏：rise → air → burrow → rise循环
前摇/预警：出土扬尘，无攻击倒计时
判定半径/宽度(px)：逐节segRAt；基准13px
弹丸寿命/有效期(s)：直到击杀/离场
伤害与特殊效果：身体露出节接触16×A
实现说明：本体不调用fireSpikes；地图主题机制相同。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
测试路径为固定巡航曲线、单身体判定；60 节逐节碰撞、40/30/30% 随机转向、反射和断节生成需要宿主龙系实体，不能把本模板当成完整长龙 AI。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
