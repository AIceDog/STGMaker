[resource]
script = ExtResource("ext_2")
id = "ft_skill_34"
title = "风暴飞鱼 · 3路风暴S弹"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B40:N40。
招式：3路风暴S弹
每轮数量：3
弹丸样式：orb + eb:whiteorb白光球
弹道与瞄准逻辑：发射基角±0.22rad；正弦振幅0.45、频率8、相位i×1.2
初始速度(px/s)：260
触发条件/重复节奏：2.6–3.6s；x<W−30
前摇/预警：无
判定半径/宽度(px)：6
弹丸寿命/有效期(s)：5
伤害与特殊效果：12×A
实现说明：不是追踪弹；弱拖尾随实际轨迹记录。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_7")])
