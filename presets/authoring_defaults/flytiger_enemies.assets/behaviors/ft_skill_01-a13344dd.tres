[resource]
script = ExtResource("ext_2")
id = "ft_skill_01"
title = "飞鹰 · 锁点俯冲"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B7:N7。
招式：锁点俯冲
每轮数量：无
弹丸样式：无
弹道与瞄准逻辑：蓄力开始记录玩家位置；短俯冲按锁点方向，叠加下坠500px/s²
初始速度(px/s)：420×speedMul
触发条件/重复节奏：hover约1.4–2.6s后转蓄力；短冲1.6s/触地后recover
前摇/预警：0.4s抖动
判定半径/宽度(px)：本体16px
弹丸寿命/有效期(s)：冲刺1.6s以内
伤害与特殊效果：接触12×A
实现说明：阈值rand在每帧比较时重新采样；recover右移180、上移150px/s。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
预览固定执行 1.6 秒；地面截停和恢复由敌人流程/宿主游戏决定。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
