[resource]
script = ExtResource("ext_3")
id = "ft_bullet_cannoneer_shell"
title = "炮师 · 可引爆铁炮弹"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），弹丸样式 B13:G13。
样式名称：可引爆铁炮弹
使用者：炮师
实际外观与拖尾：黑灰像素壳，灰色高光、黄引信核心
弹道/特殊交互：重力420；触地/山石/玩家/普通友弹/到期引爆；volatile=true
判定与视觉差异：圆形r=7；爆炸R=96
本模板支持触地/寿命/玩家命中引爆；山石碰撞和玩家普通弹击爆需由宿主游戏的可引爆弹接口接入。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(14, 14)
