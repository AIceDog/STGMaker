[resource]
script = ExtResource("ext_3")
id = "ft_bullet_pig_flame_hit"
title = "火焰飞猪 · 命中碎火"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），弹丸样式 B11:G11。
样式名称：火球分裂碎火
使用者：火焰飞猪
实际外观与拖尾：红橙像素方形、黄色核心，周期脉动
弹道/特殊交互：分裂后150px/s直线，无element=flame，因此不会另挂玩家灼烧
判定与视觉差异：圆形r=6"
scene = ExtResource("ext_2")
