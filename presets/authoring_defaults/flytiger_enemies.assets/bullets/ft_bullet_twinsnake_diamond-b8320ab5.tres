[resource]
script = ExtResource("ext_3")
id = "ft_bullet_twinsnake_diamond"
title = "双头飞蛇 · 紫菱形弹"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），弹丸样式 B20:G20。
样式名称：紫色菱形能量晶体
使用者：双头飞蛇
实际外观与拖尾：紫色旋转棱面菱形、浅紫高光；清晰紫色光带
弹道/特殊交互：双头交叉直线；每对重瞄准，飞行中不追踪
判定与视觉差异：圆形r=6；视觉纵向到1.4r"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(12, 12)
