title = "飞天骷髅 · 三路独立计时器 · 飞天骷髅 · 骨白旋转扇弹"
description = "对应招式明细第 12/13/14 行（ft_skill_06/07/08）。瞄准 1.1 秒、扇形 3 秒、环弹 4.9 秒，计时并行。预览使用 24.5 秒有限窗口，轮间旋转基角按 1.6rad/s；窗口结束后重启各计时器，不作为永久后台 AI。原源码仅 x>W−30 计时；本模板主动展示弹幕，不复刻这个疑似实现缺陷。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
