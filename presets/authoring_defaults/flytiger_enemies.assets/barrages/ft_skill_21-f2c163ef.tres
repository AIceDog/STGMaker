[resource]
script = ExtResource("ext_6")
id = "ft_skill_21"
title = "小超人 · 单束预警激光"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B27:N27。
招式：单束预警激光
每轮数量：1
弹丸样式：Beam白芯红晕
弹道与瞄准逻辑：出手时锁方向；直线长1300px
初始速度(px/s)：非飞行弹
触发条件/重复节奏：2.2–3s；x<W−20
前摇/预警：0.85s红虚线
判定半径/宽度(px)：宽10px
弹丸寿命/有效期(s)：激活0.35s
伤害与特殊效果：round(13×A)，激活时结算一次
实现说明：沿光路取样炸毁山石；无持续追随瞄准。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
