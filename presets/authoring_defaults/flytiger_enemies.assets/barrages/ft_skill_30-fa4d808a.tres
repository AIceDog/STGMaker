[resource]
script = ExtResource("ext_6")
id = "ft_skill_30"
title = "刺羽鸟 · 10向叶片环弹"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B36:N36。
招式：10向叶片环弹
每轮数量：10
弹丸样式：orb + eb:leaf绿色尖叶
弹道与瞄准逻辑：10向等分，每发角度随机±0.08rad
初始速度(px/s)：170
触发条件/重复节奏：与单发交替；1.4–2s
前摇/预警：无
判定半径/宽度(px)：6
弹丸寿命/有效期(s)：5
伤害与特殊效果：8×A
实现说明：无历史光带拖尾，绿色叶轴高亮。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
