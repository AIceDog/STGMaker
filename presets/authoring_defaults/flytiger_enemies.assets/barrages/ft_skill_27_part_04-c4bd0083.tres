[resource]
script = ExtResource("ext_6")
id = "ft_skill_27_part_04"
title = "大型蝙蝠 · 5刀S形扇射 · 大型蝙蝠 · S刀相位3"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B33:N33。
招式：5刀S形扇射
每轮数量：5
弹丸样式：blackKnife黑刀
弹道与瞄准逻辑：基础瞄准角±0.4rad，间距0.2rad；每发偏转振幅0.3、频率9、相位i×1.1
初始速度(px/s)：300
触发条件/重复节奏：偶数轮；发后冷却2.1–2.9s
前摇/预警：无
判定半径/宽度(px)：8
弹丸寿命/有效期(s)：6
伤害与特殊效果：12×A
实现说明：与单刀交替，弹速保持不变，角度摆动。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
