[resource]
script = ExtResource("ext_6")
id = "ft_skill_22_part_02"
title = "雷公 · 纵向落雷 · 雷公 · 纵向落雷"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B28:N28。
招式：纵向落雷
每轮数量：1；第4轮起2柱
弹丸样式：Lightning白芯黄边
弹道与瞄准逻辑：固定玩家x；第二柱在玩家x±90px；x钳制60..W−60
初始速度(px/s)：非飞行弹
触发条件/重复节奏：2.6–3.4s；x<W−60
前摇/预警：0.95s黄白虚线
判定半径/宽度(px)：宽56px
弹丸寿命/有效期(s)：激活0.3s
伤害与特殊效果：每柱20×A，激活时结算一次
实现说明：实际碰撞带为宽/2+玩家半径×0.7。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
独立招式使用第 4 轮后的 2 柱版本，第二柱基准 +90px；随机 ±90 和横坐标钳制由宿主游戏处理。敌人流程前 3 轮使用单柱副本。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
