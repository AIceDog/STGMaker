[resource]
script = ExtResource("ext_6")
id = "ft_skill_12"
title = "投掷奴 · 助跑标枪"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B18:N18。
招式：助跑标枪
每轮数量：1
弹丸样式：orb + eb:javelin倒刺枪
弹道与瞄准逻辑：助跑0.7s持续锁定玩家，结束时沿锁点方向直飞
初始速度(px/s)：430
触发条件/重复节奏：首轮1.6–2.6s；重复冷却3.4–4.6s+助跑0.7s
前摇/预警：0.7s助跑
判定半径/宽度(px)：13
弹丸寿命/有效期(s)：6
伤害与特殊效果：round(14×A)，实际命中后applyDown(1s)
实现说明：助跑速度300×speedMul；效果仅p.hurt成功后触发。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
