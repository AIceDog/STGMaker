const OPTION_ALIASES: Dictionary = {
	"激光生成位置": "子弹生成位置",
	"敌人生成位置": "子弹生成位置",
	"外形": "形状",
	"环绕圆心基准": "目标位置基准",
	"锁定圆心时机": "读取玩家位置",
}

static func text(title: String) -> String:
	var key = title.strip_edges()
	if TEXTS.has(key):
		return TEXTS[key]
	if ALIASES.has(key):
		return TEXTS.get(ALIASES[key], "")
	# 只接受已知的动态标题，避免把不同时间原点或坐标基准解释成同一项。
	if key.begins_with("发射节奏 · "):
		return TEXTS["发射节奏"]
	if key.begins_with("← 返回「") and key.ends_with("」"):
		return TEXTS["← 返回上一级"]
	if key in ["前摇动画", "执行动画", "后摇动画"]:
		return "选择这个动作时段播放的表现动画。\n动画用于显示，不会自动改变攻击或移动的时长。"
	if key in ["圆形参数", "菱形参数", "矩形参数", "多边形参数", "圆环参数", "扇形参数"]:
		return "根据当前几何外形设置尺寸和轮廓。\n改变外形后，对照实际碰撞确认命中范围是否合适。"
	return ""

static func option(title: String, key: String) -> String:
	var field = title.strip_edges()
	field = OPTION_ALIASES.get(field, field)
	var choices: Dictionary = OPTIONS.get(field, {})
	return choices.get(key, "")
