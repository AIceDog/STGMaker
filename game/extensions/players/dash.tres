[gd_resource type="Resource" script_class="STGExtensionDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://stg/definitions/extension_definition.gd" id="1"]
[ext_resource type="Script" path="res://game/extensions/players/dash.gd" id="2"]

[resource]
script = ExtResource("1")
kind = "player"
id = "players_dash"
title = "方向闪移"
help = "按 X / K 触发，沿输入方向位移并进入冷却；没有方向时向右。"
implementation = ExtResource("2")
fields = Array[Dictionary]([
  {
    "name": "distance",
    "label": "闪移距离",
    "type": "float",
    "default": 75,
    "min": 1,
    "max": 300,
    "step": 1
  },
  {
    "name": "cooldown",
    "label": "冷却时间 s",
    "type": "float",
    "default": 0.8,
    "min": 0.1,
    "max": 10,
    "step": 0.1
  }
])

