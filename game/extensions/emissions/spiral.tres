[gd_resource type="Resource" script_class="STGExtensionDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://stg/definitions/extension_definition.gd" id="1"]
[ext_resource type="Script" path="res://game/extensions/emissions/spiral.gd" id="2"]

[resource]
script = ExtResource("1")
kind = "emission"
id = "emissions_spiral"
title = "分批螺旋发射"
help = "每一轮逐步发射一圈弹丸；执行状态按轮次独立。"
implementation = ExtResource("2")
fields = Array[Dictionary]([
  {
    "name": "count",
    "label": "弹丸数量",
    "type": "int",
    "default": 12,
    "min": 1,
    "max": 64,
    "step": 1
  },
  {
    "name": "spacing",
    "label": "逐颗间隔 s",
    "type": "float",
    "default": 0.04,
    "min": 0.01,
    "max": 0.5,
    "step": 0.01
  },
  {
    "name": "radius",
    "label": "出生半径",
    "type": "float",
    "default": 20,
    "min": 0,
    "max": 200,
    "step": 1
  }
])

