[ext_resource type="Script" path="res://game/extensions/conditions/health_gate.gd" id="2"]

[resource]
script = ExtResource("1")
kind = "condition"
id = "conditions_health_gate"
title = "血量门槛"
help = "进入条件节点时读取当前血量，沿是或否连线执行。"
implementation = ExtResource("2")
fields = Array[Dictionary]([
  {
    "name": "threshold",
    "label": "触发血量 %",
    "type": "float",
    "default": 100,
    "min": 0,
    "max": 100,
    "step": 1
  }
])

