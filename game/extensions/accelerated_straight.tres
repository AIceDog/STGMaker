[gd_resource type="Resource" script_class="STGExtensionDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://stg/definitions/extension_definition.gd" id="1"]
[ext_resource type="Script" path="res://game/extensions/accelerated_straight.gd" id="2"]

[resource]
script = ExtResource("1")
id = "accelerated_straight"
title = "加速直飞"
help = "保留发射方向，沿直线持续加速。运动完成后照常进入下一阶段；碰撞、伤害和回收规则保持生效。"
implementation = ExtResource("2")
fields = Array[Dictionary]([{
"name": "initial_speed",
"label": "初速度 px/s",
"type": "float",
"default": 120.0,
"min": 0.0,
"max": 2000.0,
"step": 1.0,
"help": "进入这个运动阶段时的速度。"
}, {
"name": "acceleration",
"label": "加速度 px/s²",
"type": "float",
"default": 80.0,
"min": -2000.0,
"max": 2000.0,
"step": 1.0,
"help": "正数加速，负数减速；减速到零后会反向移动。"
}])

