[gd_resource type="Resource" script_class="STGLevelDefinition" format=3]

[ext_resource type="Script" path="res://stg/definitions/background_layer.gd" id="ext_1"]
[ext_resource type="Script" path="res://stg/definitions/level_definition.gd" id="ext_2"]
[ext_resource type="Script" path="res://stg/definitions/level_segment.gd" id="ext_3"]
[ext_resource type="Script" path="res://stg/definitions/level_event.gd" id="ext_4"]
[ext_resource type="Script" path="res://stg/definitions/level_exit_rule.gd" id="ext_5"]

[sub_resource type="Resource" id="sub_1"]
script = ExtResource("ext_1")
title = "远景"
scroll_ratio = 0.2

[sub_resource type="Resource" id="sub_2"]
script = ExtResource("ext_1")
title = "近景"
scroll_ratio = 0.7

[sub_resource type="Resource" id="sub_3"]
script = ExtResource("ext_4")
id = "event_xdvot"
wave_id = "mountain_boss"
spawn_position = Vector2(250, 0)

[sub_resource type="Resource" id="sub_4"]
script = ExtResource("ext_5")
mode = "condition"
condition = "defeat_all"
wait_attacks = false

[sub_resource type="Resource" id="sub_5"]
script = ExtResource("ext_3")
id = "mountain_duel"
title = "击败猪妖王"
duration = 20.0
scroll_speed = 0.0
exit_rule = SubResource("sub_4")
events = Array[ExtResource("ext_4")]([SubResource("sub_3")])

[resource]
script = ExtResource("ext_2")
id = "mountain_gate"
title = "山门试炼"
background_layers = Array[ExtResource("ext_1")]([SubResource("sub_1"), SubResource("sub_2")])
segments = Array[ExtResource("ext_3")]([SubResource("sub_5")])
