[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_092"
title = "火龙将军 · 龙身冲撞与火龙组"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 98 行。
源码类：FireDragonGeneral
阶段与可达性：龙体/崩解
组合数量：201节→剩余每3节1组；额外2小火龙
弹丸 / 机关：身体 / FireDragonMini
运动：继承空中220/冲520/地下700；火龙组独立AI
时序：头碎召2小火龙；组分波1/2/3…
伤害口径：头28×A；完整身体12×A；小龙独立伤害
备注：额外2小龙为单体FireDragonMini，注释仍写GrassDragon
源码位置：js/bosses.js:7365–7455、7496–7584
【模板适配边界】真实召唤小火龙；201 段龙身和头尾共享生命值需宿主实现。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_4")
