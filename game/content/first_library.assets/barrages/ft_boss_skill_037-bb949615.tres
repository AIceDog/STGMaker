[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_037"
title = "怪客 · 紫焰苹果雨"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 43 行。
源码类：Stranger
阶段与可达性：knives（实际苹果）
组合数量：每0.2s 9发
弹丸 / 机关：apple
运动：向下360px/s，角间0.16rad、g950；第一次落地反弹
时序：飞至上方0.6s；喷雨4s
伤害口径：12×A；r9，5.5s
备注：紫色尾迹；苹果触地反弹一次后碎裂
源码位置：js/bosses.js:2215–2240；js/entities.js:1734–1751
【模板适配边界】苹果重力落下已配置，源码的一次地面反弹需宿主接入。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
