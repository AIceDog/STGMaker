[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_053"
title = "鹤仙 · 气波冲击"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 59 行。
源码类：CraneSage
阶段与可达性：转场
组合数量：转入/转出各1圈
弹丸 / 机关：自定义shockwave
运动：圆环外扩，带宽±28，0.08s后可伤害
时序：寿命1s；起始扩速460/500再衰减
伤害口径：入20×A，出18×A，单圈只判一次
备注：镜子破裂圈另为0伤害
源码位置：js/bosses.js:2570–2572、2818–2820、3097–3112
【模板适配边界】扩圈用等比例几何缩放，圆环宽度也随半径变化；不是源码恒宽波前。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
