id = "ft_boss_skill_016"
title = "飞天狗王 · 狗头环弹"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 22 行。
源码类：DogKing
阶段与可达性：P1/P2
组合数量：P1=12；P2=14
弹丸 / 机关：orb金黄方弹
运动：185px/s均分圆周，基角t×0.9
时序：P1=2.2–2.8s；P2=1.9–2.4s
伤害口径：14×A；r6、6s
备注：半血改数量与间隔
源码位置：js/bosses.js:711–724
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
