[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_106"
title = "乔治船长 · 船炮齐射"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 112 行。
源码类：CaptainGeorge
阶段与可达性：cannon
组合数量：常态3、狂暴5；2–4轮＋一次追加
弹丸 / 机关：capShell
运动：瞄玩家直线188px/s；总幅0.22/0.36rad
时序：首蓄0.72/0.5s，轮距1.5/1.15s，追加间隔0.28s
伤害口径：15×A；r15、5.5s
备注：双连发不是所有轮次，每套随机指定一轮
源码位置：js/bosses.js:8743–8795
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
