[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_105"
title = "沙之行者 · 双头蛇召唤"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 111 行。
源码类：SandWalker
阶段与可达性：血阈值
组合数量：每个90..10%阈值20%几率
弹丸 / 机关：TwinSnake敌人
运动：直接new TwinSnake加入enemies
时序：伤害跨多阈值分别掷骰
伤害口径：召唤物独立血量、攻击
备注：同类存活≥4时不新增；不是保证召唤
源码位置：js/bosses.js:8640–8673
【模板适配边界】演示召唤飞蛇；源码按 10% 血量变化、20% 概率且上限四只的触发门控需宿主接入。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_4")
