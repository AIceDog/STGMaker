[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_044"
title = "鹤仙 · 追踪羽针"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 50 行。
源码类：CraneSage
阶段与可达性：P1羽针
组合数量：5发，间隔0.36s
弹丸 / 机关：feather
运动：350px/s、turnRate1.0追踪；3.2s后速度×1.45、turnRate2.6
时序：首发0.1s，动作约2s；弹前3s免拦截
伤害口径：13×A；r7、7s；hp1次命中可爆
备注：可击爆弹撞玩家走shellBlast；不是普通羽毛直接hurt路径
源码位置：js/bosses.js:2629–2636、2675–2689；js/game.js:3803–3807
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_14")
