[resource]
script = ExtResource("ext_6")
id = "ft_skill_19"
title = "斧头兵 · 高弧慢抛斧"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B25:N25。
招式：高弧慢抛斧
每轮数量：1
弹丸样式：axe旋转钢斧
弹道与瞄准逻辑：朝发射时玩家位置解算抛物线；g=480；旋转11rad/s
初始速度(px/s)：vx=dx/T；vy=(dy−0.5×480×T²)/T
触发条件/重复节奏：冷却2.6–3.6s+抡斧0.42s；动画过半出斧
前摇/预警：0.21s到松手
判定半径/宽度(px)：9
弹丸寿命/有效期(s)：4
伤害与特殊效果：round(8×A)
实现说明：T=clamp(|dx|/150,1.1,2.2)s；不会追踪。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
