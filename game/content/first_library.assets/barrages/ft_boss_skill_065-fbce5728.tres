[resource]
script = ExtResource("ext_6")
id = "ft_boss_skill_065"
title = "牛魔 · 魔牛直冲＋冲击环"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 71 行。
源码类：NiuMo
阶段与可达性：A-P1/P2
组合数量：P1两次；P2三次
弹丸 / 机关：身体 / 自定义环
运动：锁点680px/s，收尾环440px/s扩至R800
时序：P1 4.4/14.6s，蓄0.65；P2 13.6/15.4/17.2s，蓄0.55
伤害口径：本体30×A；环14×A、带30、单次
备注：蓄力末段仍跟踪，冲刺方向随后固定
源码位置：js/bosses.js:4519–4729、4730–4878
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
fire_pattern = SubResource("sub_2")
projectile = SubResource("sub_9")
