[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_048"
title = "鹤仙 · 全屏四轮落羽"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 54 行。
源码类：CraneSage
阶段与可达性：P1半血天葬
组合数量：12、12、16、16落点
弹丸 / 机关：feather
运动：随机x落点，从顶向下430px/s
时序：4轮间隔0.95s；预警前两轮0.75s、后两轮0.55s，另逐羽+0.04s
伤害口径：12×A；r9、4s
备注：半血且seq%3=0替换原轮换招
源码位置：js/bosses.js:2639–2647、2661–2665、2755–2777
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_9")])
