[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_179"
title = "刺客之王 · 王之环斩＋16火【预留，手动预览】"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 185 行。
源码类：AssassinKing
阶段与可达性：P4预留，常规不可达
组合数量：1环＋16弹
弹丸 / 机关：Slash / 狐火
运动：r120预警0.7，0.85s后250px/s圆环
时序：子段2s
伤害口径：火13×A；环配置24×A但坐标缺失
备注：p4n重置导致不选此序号
源码位置：js/bosses.js:14197–14210
【未接入】不会进入 Boss 默认行为，仅保留独立可编辑预览。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
