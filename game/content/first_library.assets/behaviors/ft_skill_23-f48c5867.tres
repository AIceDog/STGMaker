[resource]
script = ExtResource("ext_2")
id = "ft_skill_23"
title = "火焰飞猪 · 爆裂火球发射"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B29:N29。
招式：爆裂火球发射
每轮数量：1；第3轮起2
弹丸样式：fireball橙红像素火球
弹道与瞄准逻辑：朝玩家直线；第二颗偏+0.18rad
初始速度(px/s)：170；第二颗160
触发条件/重复节奏：2.8–3.6s；x<W−80
前摇/预警：无
判定半径/宽度(px)：10；第二颗9
弹丸寿命/有效期(s)：4
伤害与特殊效果：火球本身存16×A，实际命中走爆炸
实现说明：无重力与追踪；碰撞/越界可提前爆，不保证飞满4s。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
独立招式使用第 3 轮后的 2 颗版本；敌人流程前 2 轮使用单发副本。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
