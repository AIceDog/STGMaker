[resource]
script = ExtResource("ext_2")
id = "ft_skill_16"
title = "自爆囚 · 旋转跳跃撞击"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），招式明细 B22:N22。
招式：旋转跳跃撞击
每轮数量：无
弹丸样式：本体+火焰粒子
弹道与瞄准逻辑：移至屏幕中线；起跳按玩家左右决定水平方向；vy=−520，g=1300
初始速度(px/s)：行走46×speedMul；空中330
触发条件/重复节奏：中线蓄力→跳；落地未命中再蓄力
前摇/预警：起跳0.6s
判定半径/宽度(px)：本体34px
弹丸寿命/有效期(s)：至接触/落地
伤害与特殊效果：普通接触18×A；贴中进入自爆预警
实现说明：贴中阈值本体半径+玩家半径+6；跳跃本身不生成火焰弹。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
