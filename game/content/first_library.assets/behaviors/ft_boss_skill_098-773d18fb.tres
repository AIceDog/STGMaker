[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_098"
title = "癫狂鬣狗 · 双重咆哮"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 104 行。
源码类：MadHyena
阶段与可达性：roar
组合数量：2圈
弹丸 / 机关：自定义环
运动：嘴部r26向外330px/s，上限230；环带26
时序：咆哮0.4/0.75s各一圈
伤害口径：12×A／圈，一圈只伤一次
备注：空心环，中心不持续伤人
源码位置：js/bosses.js:8067–8092、8217–8246
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
