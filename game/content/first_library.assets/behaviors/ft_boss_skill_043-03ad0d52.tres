[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_043"
title = "蛙哥 · 蓄力冲撞"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 49 行。
源码类：FrogKing
阶段与可达性：chargeAir
组合数量：本体
弹丸 / 机关：接触
运动：前摇0.15s时锁点，0.75s后660px/s出发，叠加g500
时序：冷却7–9s；触墙/地面结束
伤害口径：contactDmg=round(28×A)，通用接触再×A
备注：该处发生二次伤害成长；与普通contact=20不同
源码位置：js/bosses.js:2420–2445；js/entities.js:5305–5307
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
