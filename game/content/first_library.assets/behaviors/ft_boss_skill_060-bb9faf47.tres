[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_060"
title = "狮身人面像 · 双爪合击碎片"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 66 行。
源码类：Sphinx
阶段与可达性：P3合爪
组合数量：2×9发
弹丸 / 机关：shard
运动：两爪分别朝当前玩家扇射，240–300px/s，扇幅1.4rad
时序：合爪动作0.9s时出
伤害口径：14×A；r11
备注：双爪分开发射源
源码位置：js/bosses.js:3785–3795
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
