[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_009"
title = "赤鬼 · 锁点冲刺"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 15 行。
源码类：Samurai
阶段与可达性：dashWind/dashing
组合数量：本体
弹丸 / 机关：接触
运动：720px/s沿起始锁定方向，不追踪；冲出边界或0.8s后回位
时序：0.7s前摇；9–12s触发周期
伤害口径：接触26×A
备注：return缓动1.2s后恢复fight
源码位置：js/bosses.js:336–370
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
