[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_126"
title = "花和尚 · 底部光谱与顶部尖刺"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 132 行。
源码类：FlowerMonk
阶段与可达性：全战斗场地
组合数量：全宽上下危险带
弹丸 / 机关：环境判定
运动：光谱初顶H×0.8，涨潮可到H×0.2；顶刺深H×0.08到0.15
时序：P1顶刺3.2s周期，1.4s下压
伤害口径：光谱12×A、顶刺14×A，受无敌帧限制
备注：每帧环境判定，胜利态停止伤害；光谱上涌为插值非瞬到
源码位置：js/bosses.js:10587–10589、10695–10701、10763–10767
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_9")])
