[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_072"
title = "牛魔 · 锁向刺球连射"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 78 行。
源码类：NiuMo
阶段与可达性：B1/B3
组合数量：B1 7/5/10/6/8；B3每组6
弹丸 / 机关：刺球Actor
运动：B1速度285–345；B3 315–375；蓄力后锁角，随机扇偏
时序：B1组间0.6/2.9/4.7/7.2/9s锚点；B3 7组、弹距0.12
伤害口径：14×A；r15、7s；重复命中冷却0.7
备注：旋转红刺球贴图、火尾，内部列表上限约91
源码位置：js/bosses.js:5245–5407、5859–5875
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_11")])
