[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_162"
title = "刺客之王 · 可打断点突刺"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 168 行。
源码类：AssassinKing
阶段与可达性：P1
组合数量：本体
弹丸 / 机关：身体
运动：蓄0.75锁出招初点→780px/s、0.5s冲→0.4s停
时序：前摇累计原始伤≥bMax5%可打断，罚停1.2s
伤害口径：冲刺30×A；常态24×A
备注：启动后不可打断；移动起点滑向玩家侧翼
源码位置：js/bosses.js:13351–13366、13703–13801
【模板适配边界】冲刺已配置；前摇内累计受伤达到最大生命 5% 的打断阈值需宿主接入。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
