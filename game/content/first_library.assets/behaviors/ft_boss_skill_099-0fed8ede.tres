[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_099"
title = "癫狂鬣狗 · 连续点冲撞"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 105 行。
源码类：MadHyena
阶段与可达性：dash
组合数量：4–6次本体冲刺
弹丸 / 机关：身体
运动：锁定位置，插值加速冲刺；10%几率向下跌落540px/s、0.45s
时序：每次1.5s预警，冲刺超0.55s或到点停止
伤害口径：冲刺30×A；普通24×A
备注：碰到目标后的爆炸粒子只是视觉
源码位置：js/bosses.js:8093–8168
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
