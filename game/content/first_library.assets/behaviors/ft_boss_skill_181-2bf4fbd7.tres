[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_181"
title = "刺客之王 · 压缩封路→消失→终杀【预留，手动预览】"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 187 行。
源码类：AssassinKing
阶段与可达性：P4预留，常规不可达
组合数量：两侧双波＋1020突刺
弹丸 / 机关：狐火 / 身体
运动：各侧7行减缺口，240/290；突刺蓄1/冲0.5/停0.5可打断
时序：封路0/0.7；设计消失0.8再冲
伤害口径：火13×A；冲30×A，打断罚2.2s
备注：p4n不选；若手动进入fk_warn/gone，外层分发只匹配p4_finalkill，后续分支无法继续
源码位置：js/bosses.js:14227–14260
【未接入】不会进入 Boss 默认行为，仅保留独立可编辑预览。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
