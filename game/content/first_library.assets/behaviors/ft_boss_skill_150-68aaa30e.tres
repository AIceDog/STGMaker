[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_150"
title = "西海王 · 终局贯穿冲刺与宽水流"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 156 行。
源码类：SeaKing
阶段与可达性：P9
组合数量：本体＋逐帧水流
弹丸 / 机关：身体 / 水流Actor
运动：蓄1.35s，1.0s锁点→1500px/s直冲出屏→另一侧返1s
时序：两次combo计数回0后执行，结束1.6s重进组合
伤害口径：冲刺40×A；水流10×A、长100宽110、2.6s
备注：水流各0.55s冷却；场上上限90；返回恢复接触34
源码位置：js/bosses.js:12246–12300、12054–12070
【模板适配边界】锁定方向高速冲刺；宽水迹需组合第 151 条。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
