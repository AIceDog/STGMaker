[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_170"
title = "刺客之王 · 左右封路＋点突刺"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 176 行。
源码类：AssassinKing
阶段与可达性：P3远距/换位
组合数量：每侧6行减缺口；另本体突刺
弹丸 / 机关：狐火 / 身体
运动：左右260px/s，y100..390每58右侧额外+24；abs(y−玩家y)<34跳过
时序：远距0.8s后蓄0.5、860冲0.45/停0.3；换位只发封路
伤害口径：火11×A、r8；冲30×A
备注：距离>380池1/3；第二血每3次判招换位也发封路
源码位置：js/bosses.js:14069–14078、14149–14164
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_13")])
