[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_113"
title = "雪巫 · 上下双冰环＋冰雨"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 119 行。
源码类：SnowWitch
阶段与可达性：c3
组合数量：每次2环，一大一小上下轮换
弹丸 / 机关：icering / icicle
运动：玩家y±80再±48抖动；雨同时输出
时序：双环每1.12/0.85s；高潮最后4.2/3.3s
伤害口径：环12×A，雨10×A
备注：与常态环共享形状参数
源码位置：js/bosses.js:9371–9385
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_7")])
