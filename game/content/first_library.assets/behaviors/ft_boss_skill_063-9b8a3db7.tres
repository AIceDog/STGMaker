[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_063"
title = "牛魔 · 双角气弹扇"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 69 行。
源码类：NiuMo
阶段与可达性：A-P1
组合数量：两源各5发
弹丸 / 机关：niuGas
运动：270–340px/s；幅0.95rad
时序：0.4/2.7/11.9/13.8s
伤害口径：13×A；r11
备注：黄色魔气尾
源码位置：js/bosses.js:4519–4729、4730–4878
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_17")])
