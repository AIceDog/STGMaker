[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_036"
title = "怪客 · S形高速冲刺"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 42 行。
源码类：Stranger
阶段与可达性：sdash
组合数量：本体
弹丸 / 机关：接触
运动：x向左820px/s，y=初始y+sin(t×11)×140
时序：≤1.4s或x<110后归位0.8s
伤害口径：接触30×A
备注：不按玩家实时位置追踪
源码位置：js/bosses.js:2189–2194、2208–2214
【模板适配边界】身体 S 形轨迹可编辑，路径按一次冲刺演示。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "complete"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_1")])
