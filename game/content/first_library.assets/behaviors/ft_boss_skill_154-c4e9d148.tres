[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_154"
title = "靓星 · 固定漩涡危险区"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 160 行。
源码类：LiangStar
阶段与可达性：P2及残留
组合数量：最多3个
弹丸 / 机关：漩涡Actor
运动：r56–62成形后固定，中心接触伤＋环弹
时序：成形0.55/1.6/2.1s；接触冷却0.7s
伤害口径：接触10×A；环11×A
备注：未施加吸力或玩家减速；fadeDelay=0无效，首个漩涡与吸收转场可能未按预期清除
源码位置：js/bosses.js:12864–12874、13065–13104、12602–12612
【模板适配边界】固定漩涡判伤演示；不补造源码未生效的吸引 / 治疗。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_7")])
