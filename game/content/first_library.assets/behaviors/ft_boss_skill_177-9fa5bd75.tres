[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_177"
title = "刺客之王 · 全域交错狐火"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 183 行。
源码类：AssassinKing
阶段与可达性：P4实际可达
组合数量：左右交替4×7
弹丸 / 机关：狐火Actor
运动：两组320总幅1.1rad；后两组340总幅1.4rad
时序：0/0.55/1.05/1.6s，2.4s后转P3
伤害口径：13×A
备注：每次重入P4 reset p4n=0，所以目前只执行这招
源码位置：js/bosses.js:13516–13518、14165–14187、14261–14266
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_9")])
