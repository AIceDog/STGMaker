[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_061"
title = "狮身人面像 · 双源反向螺旋"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 67 行。
源码类：Sphinx
阶段与可达性：P3自旋
组合数量：每0.15s两发
弹丸 / 机关：eyeGem
运动：左右源按±spirA射225px/s
时序：13–18.4s自旋段
伤害口径：12×A；r9、5s
备注：与中心缺口环并行
源码位置：js/bosses.js:3813–3835
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
