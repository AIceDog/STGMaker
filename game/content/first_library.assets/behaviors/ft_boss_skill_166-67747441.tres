[resource]
script = ExtResource("ext_2")
id = "ft_boss_skill_166"
title = "刺客之王 · 狐刃环斩后的扩散弹"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 172 行。
源码类：AssassinKing
阶段与可达性：P2
组合数量：12发
弹丸 / 机关：狐火Actor
运动：230px/s全圆，起角0.1
时序：进入环斩0.9s追加，2s结束
伤害口径：狐火13×A；r9
备注：环斩配置22×A但坐标缺失不命中，扩散弹仍正常
源码位置：js/bosses.js:13947–13963
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
entry_id = "parallel"
nodes = Array[ExtResource("ext_1")]([SubResource("sub_5")])
