[resource]
script = ExtResource("ext_9")
id = "ft_enemy_bombPrisoner"
title = "自爆囚"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B18:K18。
分类：角斗场自爆
攻击模式：跳跃接触／闪红自爆／死亡爆炸
弹丸/攻击对象：无弹丸
行为状态机与移动逻辑：march到中线 → windup → leap；未命中落地继续windup；贴玩家则preboom，0.35s后爆炸
自然出场/召唤条件：自然池：击败4个Boss后；仅罗马角斗场/月痕沙海解锁
基础接触伤害：18
出场保护/免疫：出场1.2s
实现说明：直接贴中后自爆扣玩家最大血量40%，重置受伤无敌帧；被击杀也炸，但使用普通18点基数而非40%。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
死亡挂 ft_skill_18；正常跳跃流程只在测试落点近距离分支调用 ft_skill_17，测试回合结束重启跳跃。原游戏空中接触事件、暂停并越过受伤无敌帧以及自爆后移除由宿主角色/生命周期接入。"
on_death_skill_id = "ft_skill_18"
color = Color(1, 0.5176471, 0.35686275, 1)
start_position = Vector2(100, 200)
phases = Array[ExtResource("ext_2")]([SubResource("sub_25")])
entity_settings = SubResource("sub_1")
