[resource]
script = ExtResource("ext_9")
id = "ft_boss_PigKing"
title = "火焰飞猪王"
description = "来源：Boss总览 / 阶段与转换，源码类 PigKing。
出现条件：通用地图池；基础权重3，见过后权重减半
阶段结构：单血；通用30%狂暴标记
招式组合：3路爆裂火球；另有喷火分支但计时器未初始化
移动：右侧悬停，随玩家高度缓慢调整，叠加横向与纵向正弦摆动
本体触碰：22
注意事项：喷火不是普通弹丸；构造未初始化flameDur/flameBreathT，原始入场后计时成为NaN，分支通常不可触发。
源码位置：js/bosses.js:104–205；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.9137255, 0.5921569, 0.40392157, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_10")])
entity_settings = SubResource("sub_1")
