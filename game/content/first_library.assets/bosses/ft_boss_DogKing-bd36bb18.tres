[resource]
script = ExtResource("ext_9")
id = "ft_boss_DogKing"
title = "飞天狗王"
description = "来源：Boss总览 / 阶段与转换，源码类 DogKing。
出现条件：通用地图池；基础权重3，见过后权重减半
阶段结构：单血；50%解体进入P2
招式组合：12/14向环弹、狗腿/四肢刺击、收肢光束
移动：狗头悬停持续环弹；半血将两腿夹击换成四肢轮流突刺并附激光
本体触碰：28
注意事项：肢体攻击命中判定只在尖端，连接肢体画面不等于全长伤害。
源码位置：js/bosses.js:638–823；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.7019608, 0.5803922, 0.9372549, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_17"), SubResource("sub_40")])
entity_settings = SubResource("sub_1")
