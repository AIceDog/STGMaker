[resource]
script = ExtResource("ext_9")
id = "ft_boss_CrowCount"
title = "鸦伯爵"
description = "来源：Boss总览 / 阶段与转换，源码类 CrowCount。
出现条件：城堡（castle）限定；本局首次90%首秀掷骰，见过后普通池
阶段结构：单血；≤30%速度与节奏强化
招式组合：大中小三拍宝石、扇形折返、抛物线、高潮两组弹并行
移动：随机三拍飞掷/回旋抛掷；接近时连闪远点；66%一次珠宝盗窃
本体触碰：14
注意事项：正常随机避免重复也只重抽一次；三种宝石尺寸不是等比1/1.5/2，实际r12/36/48。
源码位置：js/bosses.js:9519–9937；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.5137255, 0.7176471, 0.9490196, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_38"), SubResource("sub_61"), SubResource("sub_84")])
entity_settings = SubResource("sub_1")
