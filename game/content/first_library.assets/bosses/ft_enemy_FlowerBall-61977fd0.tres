[resource]
script = ExtResource("ext_9")
id = "ft_enemy_FlowerBall"
title = "花和尚无敌肉球（补充机关）"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B35:K35。
分类：Boss机关实体（isBoss=true）
攻击模式：跳动碰撞／向上扇射／延迟自爆
弹丸/攻击对象：orb（玫红/青色）
行为状态机与移动逻辑：升起动画 → 下方40%区域横向反弹+上下弹跳 → Boss指令可切预警自爆
自然出场/召唤条件：花和尚阶段技能生成；Boss死亡、清球或自爆后移除
基础接触伤害：16
出场保护/免疫：完全无敌；免击退
实现说明：加入g.enemies但被代码标为isBoss=true，单独补充；虚拟hp=1e12，不是可击杀小怪。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
普通流程只有运动与向上扇射。ft_skill_42 的停球自爆必须由 Boss 外部调用，未作为自主循环动作。此实体属于补充机关，不计入 28 类小怪。"
color = Color(1, 0.39607844, 0.80784315, 1)
start_position = Vector2(240, 240)
phases = Array[ExtResource("ext_2")]([SubResource("sub_24")])
entity_settings = SubResource("sub_1")
