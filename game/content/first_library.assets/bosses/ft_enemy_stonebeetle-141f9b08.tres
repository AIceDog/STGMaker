[resource]
script = ExtResource("ext_9")
id = "ft_enemy_stonebeetle"
title = "魔石甲虫"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B27:K27。
分类：中型飞行弹幕
攻击模式：0.9s蓄力／高速魔法矛
弹丸/攻击对象：orb + eb:flame
行为状态机与移动逻辑：玩家右侧约340px悬停；atk冷却 → charge水晶蓄力 → 发射 → 冷却
自然出场/召唤条件：自然池：击败3个Boss后；中档还须30%随机解锁
基础接触伤害：14
出场保护/免疫：出场2s
实现说明：名字称魔法矛，实际画圆形红橙火焰弹并带弱拖尾；动态血量目标10s。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
color = Color(0.6627451, 0.5686275, 0.8156863, 1)
start_position = Vector2(290, -40)
phases = Array[ExtResource("ext_2")]([SubResource("sub_24")])
entity_settings = SubResource("sub_1")
