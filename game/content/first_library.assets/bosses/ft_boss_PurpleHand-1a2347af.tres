[resource]
script = ExtResource("ext_9")
id = "ft_boss_PurpleHand"
title = "紫手"
description = "来源：Boss总览 / 阶段与转换，源码类 PurpleHand。
出现条件：紫色荒地（wasteland）限定；本局首次90%首秀掷骰，见过后普通池
阶段结构：单血；≤30%缩短节奏、B符卡4→6
招式组合：三路紫扇、狐火、摇摆符卡、角落符卡齐射
移动：A随机三招→等待→B角落符卡夹击→A循环；等待中可能瞬移
本体触碰：20
注意事项：瞬移冷却2.2–3.6s只在等待态减少，每次到时65%执行。
源码位置：js/bosses.js:10190–10427；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.9137255, 0.5921569, 0.40392157, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_31")])
entity_settings = SubResource("sub_1")
