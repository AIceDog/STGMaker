[resource]
script = ExtResource("ext_9")
id = "ft_enemy_ramFighter"
title = "羊头斗士"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B15:K15。
分类：角斗场地面
攻击模式：锁点助跑／跳跃撞击
弹丸/攻击对象：无弹丸
行为状态机与移动逻辑：walk → windup → leap → recenter（回中线）→ windup循环；起跳时按目标左右定水平朝向
自然出场/召唤条件：自然池：击败1个Boss后；仅罗马角斗场/月痕沙海解锁
基础接触伤害：12
出场保护/免疫：出场1.2s
实现说明：空中接触伤害从12升至30，落地恢复12；回中线后不再等初始atkT，直接再次助跑。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。"
color = Color(0.8784314, 0.74509805, 0.5686275, 1)
start_position = Vector2(210, 200)
phases = Array[ExtResource("ext_2")]([SubResource("sub_31")])
entity_settings = SubResource("sub_1")
