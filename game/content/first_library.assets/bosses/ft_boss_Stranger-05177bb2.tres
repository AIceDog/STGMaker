[resource]
script = ExtResource("ext_9")
id = "ft_boss_Stranger"
title = "怪客"
description = "来源：Boss总览 / 阶段与转换，源码类 Stranger。
出现条件：通用地图池；基础权重3，见过后权重减半
阶段结构：单血；通用30%狂暴标记
招式组合：S形冲锋、向下9路苹果雨、巨十字追踪吸血、3雷公召唤
移动：4招固定顺序：S冲刺→上空苹果雨→十字追击→召唤雷公，招后归位
本体触碰：30
注意事项：knives状态实际发苹果；十字命中每次招式最多回血一次。
源码位置：js/bosses.js:2153–2285；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.9137255, 0.5921569, 0.40392157, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_38")])
entity_settings = SubResource("sub_1")
