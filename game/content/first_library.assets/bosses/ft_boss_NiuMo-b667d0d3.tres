[resource]
script = ExtResource("ext_9")
id = "ft_boss_NiuMo"
title = "牛魔"
description = "来源：Boss总览 / 阶段与转换，源码类 NiuMo。
出现条件：飞喵草原（grassland）限定；普通模式仅Boss序号5/7/11/13（注册早轮forceChance被此限制过滤）
阶段结构：A血空觉醒；B阶段可由计时或血空推进，逐段回血
招式组合：双角气弹、角机关、冲撞环、刺球/爆球/反弹球、双臂、双眼扫射
移动：A三阶段定时循环→真身B1刺球→B2双臂→B3加速刺球→B4终章
本体触碰：26
注意事项：A血≤10%且未直接打空会锁血3s；B演员独立碰撞，并非Bullet；B2区域预警/冲臂辅助函数存在，但当前B2时间线不调用区域或dash，冲臂在B4使用。
源码位置：js/bosses.js:4291–6281；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.5137255, 0.7176471, 0.9490196, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_31"), SubResource("sub_54"), SubResource("sub_84"), SubResource("sub_121"), SubResource("sub_144"), SubResource("sub_181"), SubResource("sub_225")])
entity_settings = SubResource("sub_1")
