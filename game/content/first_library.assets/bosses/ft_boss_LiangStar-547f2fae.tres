[resource]
script = ExtResource("ext_9")
id = "ft_boss_LiangStar"
title = "靓星"
description = "来源：Boss总览 / 阶段与转换，源码类 LiangStar。
出现条件：海底（seabed）限定；普通模式仅Boss序号5/7/11/13（注册早轮forceChance被此限制过滤）
阶段结构：三条血；每次吸收2.6s回满，P4/P5按血量加压
招式组合：海星环、多中心漩涡、持续追踪卡、2–5个可受击头群
移动：第一血P1环弹→P2漩涡→P3追卡循环；后两血本体＋可受击海星头群
本体触碰：22
注意事项：P1–3主脑袋受伤减半；P4/5头群命中扣共享Boss血50%，原始伤累计700后该头离场5s。fadeWhirl(delay=0)未触发fade，可能残留漩涡到P4/P5。
源码位置：js/bosses.js:12523–13307；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.9137255, 0.5921569, 0.40392157, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_10"), SubResource("sub_26"), SubResource("sub_35"), SubResource("sub_58"), SubResource("sub_81"), SubResource("sub_111"), SubResource("sub_134"), SubResource("sub_157")])
entity_settings = SubResource("sub_1")
