[resource]
script = ExtResource("ext_9")
id = "ft_enemy_shieldSlave"
title = "盾奴"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B16:K16。
分类：角斗场地面
攻击模式：连续抛射塔盾
弹丸/攻击对象：orb + eb:shield
行为状态机与移动逻辑：walk → throw；先走至x<W×0.88且计时结束，之后站定投盾；太远缓慢逼近
自然出场/召唤条件：自然池：击败2个Boss后；仅罗马角斗场/月痕沙海解锁
基础接触伤害：12
出场保护/免疫：出场1.2s
实现说明：stopRange=420未参与AI停步判断；盾是攻击弹丸，敌人本体没有举盾减伤逻辑。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
首发 0.4 秒；后续连续 1.5 秒间隔，4 发测试窗口后再开始。盾是弹丸，本体无举盾防护。"
color = Color(0.76862746, 0.60784316, 0.39215687, 1)
start_position = Vector2(260, 200)
phases = Array[ExtResource("ext_2")]([SubResource("sub_10")])
entity_settings = SubResource("sub_1")
