[resource]
script = ExtResource("ext_9")
id = "ft_enemy_bat"
title = "蝙蝠"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），小怪总览 B8:K8。
分类：常规飞行
攻击模式：群体波浪逼近／接触
弹丸/攻击对象：无弹丸
行为状态机与移动逻辑：右侧逼近到玩家x+90；随后正弦绕飞、略向左漂移；高度追玩家并叠加波浪
自然出场/召唤条件：自然池：击败0个Boss后
基础接触伤害：8
出场保护/免疫：无
实现说明：普通3–5只一组，间隔0.22s；怪物潮每组数量×3。
模板使用 A=1、speedMul=1；区间冷却取中值。血量缩放、自然刷新、奖励、角色护盾/倒地/最大生命伤害、地形破坏和龙身分裂由宿主游戏接入。
只演示一只；关卡编队可另设 3–5 只、0.22 秒间隔。"
color = Color(0.6666667, 0.50980395, 0.8745098, 1)
start_position = Vector2(310, -50)
phases = Array[ExtResource("ext_2")]([SubResource("sub_10")])
entity_settings = SubResource("sub_1")
