[resource]
script = ExtResource("ext_9")
id = "ft_boss_RaccoonRover"
title = "浣熊漫游者"
description = "来源：Boss总览 / 阶段与转换，源码类 RaccoonRover。
出现条件：霓虹喵都（cyber）限定；本局首次90%首秀掷骰，见过后普通池
阶段结构：单血；通用30%标记
招式组合：移动持续留下4s危险足迹
移动：orbit→aim→border三路线各5s循环：绕玩家、锁点冲刺、沿8点边框飞行
本体触碰：20
注意事项：足迹爆炸只作视觉，真正判定是足迹圆；常态与狂暴参数相同。
源码位置：js/bosses.js:8327–8529；js/game.js:2276–2355
模板是可编辑战斗编排。贴图、动画、地图刷怪条件、玩家抓取 / 治疗、龙身 / 肢体 / 分身实体共享血量需要宿主游戏接入；详见各招式适配边界。"
color = Color(0.7019608, 0.5803922, 0.9372549, 1)
start_position = Vector2(270, -30)
phases = Array[ExtResource("ext_2")]([SubResource("sub_31")])
entity_settings = SubResource("sub_1")
