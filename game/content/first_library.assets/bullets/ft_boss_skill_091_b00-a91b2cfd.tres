[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_091_b00"
title = "火龙将军 · 持续弧形喷火 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 97 行。
源码类：FireDragonGeneral
阶段与可达性：龙体
组合数量：非Bullet
弹丸 / 机关：区域
运动：每帧baseA直接瞄玩家，距离30..CFG.W；粒子扇1.1rad
时序：持续2.6s，之后6.5–9s；初4–7s
伤害口径：8×A反复调用hurt，受无敌帧限制
备注：角度测试用当帧玩家方向，实际角差恒0；有效区更接近半径范围
源码位置：js/bosses.js:7456–7490
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
form = "area"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(1920, 1920)
