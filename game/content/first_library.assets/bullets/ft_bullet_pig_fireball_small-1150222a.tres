[resource]
script = ExtResource("ext_3")
id = "ft_bullet_pig_fireball_small"
title = "火焰飞猪 · 第二颗火球"
description = "来源：FlyTiger_小怪攻击模式与行为逻辑.xlsx（2026-10-13），弹丸样式 B10:G10。
样式名称：爆裂大火球
使用者：火焰飞猪
实际外观与拖尾：红褐外层→橙→黄→白芯像素方火球，外层脉动；绘制大小以11px为基准
弹道/特殊交互：无重力直线；到期/越界/撞玩家爆炸，再分裂flame；普通玩家子弹不能击爆
判定与视觉差异：圆形r=10；第二颗r=9"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(20, 20)
