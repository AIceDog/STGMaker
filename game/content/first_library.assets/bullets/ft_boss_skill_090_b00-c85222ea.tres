[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_090_b00"
title = "火龙将军 · 红火瞄准扇 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 96 行。
源码类：FireDragonGeneral
阶段与可达性：龙体
组合数量：3发；出土追击4s内5发
弹丸 / 机关：redfire
运动：360px/s，角差0.18
时序：0.45–0.8s；追击0.22–0.4s
伤害口径：15×A；r9、5s
备注：配置红色火尾；实体渲染缺独立redfire主体分支
源码位置：js/bosses.js:7425–7438；js/entities.js:redfire
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(18, 18)
