[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_087_b00"
title = "巨型骨龙王 · 骨蛇穿场 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 93 行。
源码类：BoneDragonKing
阶段与可达性：B1/B2/B3高潮
组合数量：B1/2顺次3；B3四边同时4
弹丸 / 机关：bonesnake
运动：340或高潮360px/s，正弦amp0.38/freq5.5
时序：B1弹距0.3角±0.5；B2弹距0.28角±0.42；B3每2轮
伤害口径：15×A；r10、10s
备注：是蜿蜒蛇形子弹；不是可杀敌人
源码位置：js/bosses.js:6916–6930、6995–7003、7084–7092、7210–7223
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(20, 20)
