[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_064_b00"
title = "牛魔 · 双角回旋镖 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 70 行。
源码类：NiuMo
阶段与可达性：A-P1
组合数量：2机关
弹丸 / 机关：角Actor
运动：飞向玩家上下±120→悬停0.6→R120反向绕1圈→580返回
时序：6.6s触发
伤害口径：15×A；r15；0.7s命中冷却
备注：悬停阶段无伤，其余移动期有伤
源码位置：js/bosses.js:4519–4729、4730–4878
【模板适配边界】角的绕玩家和回收轨迹可编辑，末段以追踪轨迹演示，不是回到头部的实体挂载。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(30, 30)
