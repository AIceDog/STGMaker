[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_135_b00"
title = "花和尚 · 和尚上下摆动发刃＋6肉球 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 141 行。
源码类：FlowerMonk
阶段与可达性：P3组合
组合数量：刃每1.1s、6球每0.7s
弹丸 / 机关：光刃Actor / FlowerBall
运动：长0.5W厚0.08H左飞300自旋2；高度贴玩家
时序：直到6球都消失才回爆球
伤害口径：刃20×A；球/弹同肉球条目
备注：这些普通肉球不能打死且组合未设置自动过期：可能一直停在combo，直到血空跳P4
源码位置：js/bosses.js:10967–10988、10451–10528
【模板适配边界】有限三轮组合供预览收尾；源码可能一直卡在此组合直到 HP 清空。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(243, 27)
