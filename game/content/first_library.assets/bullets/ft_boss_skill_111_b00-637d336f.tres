[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_111_b00"
title = "雪巫 · 扫向玩家的冰晶雨 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 117 行。
源码类：SnowWitch
阶段与可达性：rain/c1/c3
组合数量：稀3/4发每秒，密8/11；c1=9/12，c3=7/9
弹丸 / 机关：icicle
运动：175–268px/s；法阵以1.05/1.7rad/s转向，角限制1.15..2.95；交错±0.11加抖0.05
时序：每密度段2.2/1.4s，无段间停顿
伤害口径：10×A；r9、5s
备注：蓝白六角冰晶；不追加冻结效果
源码位置：js/bosses.js:9252–9266、9284–9309、9344–9349、9371–9376
【模板适配边界】演示顶端落冰连射；整场随血量逐渐改变雨密度需在流程中加血量分支。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(18, 18)
