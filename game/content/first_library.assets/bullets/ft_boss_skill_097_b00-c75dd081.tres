id = "ft_boss_skill_097_b00"
title = "火龙将军 · 空中斩落＋大爆炸 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 103 行。
源码类：FireDragonGeneral
阶段与可达性：B2
组合数量：本体＋一次圆范围
弹丸 / 机关：身体 / 范围
运动：名义跃空0.5s、锁点至0.9s，780px/s斩落；爆炸半径CFG.W×0.25
时序：三柱后；名义硬直2s（计时双加）
伤害口径：爆炸22×A；本体28×A
备注：爆炸伤害中心在Boss(x,y)，视觉环在地面；开场火浪只有视觉
源码位置：js/bosses.js:7820–7884
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
form = "area"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(480, 480)
