id = "ft_boss_skill_003_b00"
title = "雷公巨兽 · 纵向三连雷 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 9 行。
源码类：ThunderBehemoth
阶段与可达性：常态
组合数量：3柱：玩家x、x±120
弹丸 / 机关：Lightning
运动：固定全高竖线，宽92px
时序：2.2–2.8s轮换；雷体0.95s预警、0.3s激活
伤害口径：round(22×A)／柱，激活时一次判定
备注：出手后不追踪位置
源码位置：js/bosses.js:237–246；js/entities.js:4065–4170
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
form = "laser"
scene = ExtResource("ext_2")
