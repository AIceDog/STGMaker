[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_069_b01"
title = "牛魔 · 四角包围/双角高速自旋 · 弹体 2"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 75 行。
源码类：NiuMo
阶段与可达性：A-P3
组合数量：4悬停角；后2旋转角
弹丸 / 机关：角Actor
运动：围住玩家1.1s后返回；双角R135实时玩家圆心3.6rad/s转2.2圈→切向560甩出
时序：0.6s包围；5s双角自旋
伤害口径：15×A；r15
备注：包围悬停不直接刺玩家；返回与旋转有碰撞
源码位置：js/bosses.js:4519–4729、4730–4878
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(30, 30)
