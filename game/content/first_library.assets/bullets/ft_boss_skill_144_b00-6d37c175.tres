[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_144_b00"
title = "西海王 · 基础三叉戟五式 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 150 行。
源码类：SeaKing
阶段与可达性：P3
组合数量：纵1→斜1→交叉2→边缘旋扫1→横1
弹丸 / 机关：三叉戟Actor
运动：直行640；旋扫0.42rad/s、2.6s；戟身长404×0.62
时序：每2.5s；露尖0.55s后直冲；交叉第2延0.5
伤害口径：戟15×A，0.6s冷却；水流另10×A
备注：首轮v；旋扫和直冲留独立水流危险
源码位置：js/bosses.js:11938–11961、11975–11988、12004–12069
【模板适配边界】三叉戟用整段矩形碰撞；水迹通过独立第 151 条模板配置。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(250, 30)
