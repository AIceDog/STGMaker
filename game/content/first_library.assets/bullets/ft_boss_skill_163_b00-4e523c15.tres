[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_163_b00"
title = "刺客之王 · 斩击分支（当前坐标缺失）【仅视觉，无伤害】 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 169 行。
源码类：AssassinKing
阶段与可达性：P1/P2/P3
组合数量：扇斩或环斩
弹丸 / 机关：Slash Actor
运动：配置P1扇r170幅1.25/22；P2环r105/22、近战扇r120幅0.9/18、环r110/20；P3各变体
时序：预警0.3–0.8s，激活0.28s
伤害口径：配置伤害均×A；当前sl.x/sl.y未赋值，命中不成立
备注：不能把配置数值当作当前可命中的斩击；渲染同样使用缺失坐标
源码位置：js/bosses.js:13695–13702、13863–13872、13947–14008、14113–14132、14483–14509、14789–14828
【仅视觉】源码缺少有效命中入口，模板不会补造伤害。
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
form = "area"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(340, 340)
