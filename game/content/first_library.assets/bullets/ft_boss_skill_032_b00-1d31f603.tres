[resource]
script = ExtResource("ext_3")
id = "ft_boss_skill_032_b00"
title = "斧王 · 大型飞斧 · 弹体 1"
description = "来源：《FlyTiger_Boss攻击模式与行为逻辑.xlsx》招式明细第 38 行。
源码类：BossMan
阶段与可达性：第二命内P1/P2/P3/P4/P5
组合数量：通常1；狂暴3路±0.28rad
弹丸 / 机关：axe + p3spr
运动：实际速度输入×0.7：252/294/336px/s；朝玩家直线
时序：内P1=1.3–1.9s；其余随序列
伤害口径：13×A；r22，5s
备注：火车部件被敌斧或友弹一击毁，部件爆炸110px、10×A
源码位置：js/bosses.js:1681–1688、1914–1945、1971–1982
模板按 A=1 与 speedMul=1；随机范围取常用中值。召唤实体有预览存活上限。"
scene = ExtResource("ext_2")
visual = SubResource("sub_3")
collision = SubResource("sub_1")
beam_path_size = Vector2(44, 44)
