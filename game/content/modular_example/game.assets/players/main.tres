[gd_resource type="Resource" script_class="STGPlayerDefinition" format=3]

[ext_resource type="Script" path="res://game/extensions/players/dash.gd" id="ext_1"]
[ext_resource type="Script" path="res://stg/definitions/extension_definition.gd" id="ext_2"]
[ext_resource type="Script" path="res://stg/definitions/extension_binding.gd" id="ext_3"]
[ext_resource type="Script" path="res://stg/definitions/player_definition.gd" id="ext_4"]
[ext_resource type="Script" path="res://game/extensions/players/spread_weapon.gd" id="ext_5"]

[sub_resource type="Resource" id="sub_1"]
script = ExtResource("ext_2")
kind = "player"
id = "players_dash"
title = "方向闪移"
help = "按 X / K 触发，沿输入方向位移并进入冷却；没有方向时向右。"
implementation = ExtResource("ext_1")
fields = Array[Dictionary]([{
"default": 75,
"label": "闪移距离",
"max": 300,
"min": 1,
"name": "distance",
"step": 1,
"type": "float"
}, {
"default": 0.8,
"label": "冷却时间 s",
"max": 10,
"min": 0.1,
"name": "cooldown",
"step": 0.1,
"type": "float"
}])

[sub_resource type="Resource" id="sub_2"]
script = ExtResource("ext_3")
definition = SubResource("sub_1")
parameters = {
"cooldown": 0.8,
"distance": 75
}

[sub_resource type="Resource" id="sub_3"]
script = ExtResource("ext_2")
kind = "player"
id = "players_spread_weapon"
title = "三向射击"
help = "替换主角武器，保持移动与技能模块独立。"
implementation = ExtResource("ext_5")
fields = Array[Dictionary]([{
"default": 0.18,
"label": "射击间隔 s",
"max": 2,
"min": 0.02,
"name": "interval",
"step": 0.01,
"type": "float"
}])

[sub_resource type="Resource" id="sub_4"]
script = ExtResource("ext_3")
definition = SubResource("sub_3")
parameters = {
"interval": 0.18
}

[resource]
script = ExtResource("ext_4")
weapon = SubResource("sub_4")
ability = SubResource("sub_2")
